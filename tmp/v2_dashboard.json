{"content": "<!-- wp:columns {\"isStackedOnMobile\":false} -->\n<div class=\"wp-block-columns is-not-stacked-on-mobile\"><!-- wp:column {\"width\":\"220px\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:220px\"><!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"1rem\",\"right\":\"0.75rem\",\"bottom\":\"1rem\",\"left\":\"0.75rem\"}},\"border\":{\"right\":{\"color\":\"#e5e7eb\",\"width\":\"1px\"}}},\"backgroundColor\":\"base\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group has-base-background-color has-background\" style=\"border-right-color:#e5e7eb;border-right-width:1px;padding-top:1rem;padding-right:0.75rem;padding-bottom:1rem;padding-left:0.75rem\"><!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/dashboard/\">🏠 Dashboard</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/cared-ones/\">❤️ Loved Ones</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/bookings/\">📅 Appointments</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/inbox/\">💬 Messages</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/care-circle/\">👥 Care Teams</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/jobs/\">💼 Jobs Board</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/store-listing/\">🔍 Find Help</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/gps-tracking/\">📍 GPS Tracking</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/favorites/\">⭐ Favorites</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/community/\">🗣 Community</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/articles/\">📰 Articles</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/provider-dashboard/\">⚙️ Provider Hub</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/notifications/\">🔔 Notifications</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/profile/\">👤 My Profile</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"style\":{\"color\":{\"background\":\"#f9fafb\"}}} -->\n<div class=\"wp-block-column has-background\" style=\"background-color:#f9fafb\"><!-- wp:html -->\n<style>\n#dash-app{max-width:72rem;margin:0 auto;padding:1.5rem 1rem;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}\n#dash-app *{box-sizing:border-box}\n.da-header{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:1.5rem;gap:1rem}\n.da-header h1{font-size:1.5rem;font-weight:700;color:#0f172a;margin:0}\n.da-header p{color:#64748b;font-size:0.875rem;margin:0.25rem 0 0}\n.da-stats{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem;margin-bottom:1.5rem}\n@media(min-width:1024px){.da-stats{grid-template-columns:repeat(4,1fr)}}\n.da-stat-card{background:#fff;border-radius:0.75rem;padding:1rem;box-shadow:0 1px 3px 0 rgba(0,0,0,.1),0 1px 2px -1px rgba(0,0,0,.1);border:1px solid transparent}\n.da-stat-card .da-sc-inner{display:flex;align-items:center;gap:0.75rem}\n.da-stat-card .da-sc-icon{width:20px;height:20px;flex-shrink:0}\n.da-stat-card .da-sc-val{font-size:1.5rem;font-weight:700;color:#0f172a;line-height:1.2}\n.da-stat-card .da-sc-lbl{font-size:0.75rem;color:#64748b}\n.da-grid{display:grid;gap:1.5rem;margin-bottom:1.5rem}\n@media(min-width:1024px){.da-grid{grid-template-columns:1fr 1fr}}\n.da-card{background:#fff;border-radius:0.75rem;box-shadow:0 1px 3px 0 rgba(0,0,0,.1),0 1px 2px -1px rgba(0,0,0,.1);border:1px solid transparent;overflow:hidden}\n.da-card-hdr{display:flex;align-items:center;justify-content:space-between;padding:1.25rem 1.5rem 0.75rem}\n.da-card-hdr h3{font-size:1.125rem;font-weight:600;margin:0;color:#0f172a}\n.da-card-hdr a{font-size:0.8rem;color:#64748b;text-decoration:none;display:flex;align-items:center;gap:0.25rem;cursor:pointer}\n.da-card-hdr a:hover{color:#0d9488}\n.da-card-body{padding:0 1.5rem 1.25rem}\n.da-booking-row,.da-task-row{display:flex;align-items:center;gap:0.75rem;padding:0.75rem;border-radius:0.5rem;background:#f8fafc;margin-bottom:0.5rem}\n.da-booking-date{text-align:center;flex-shrink:0;min-width:2.5rem}\n.da-booking-date .da-bd-month{font-size:0.7rem;color:#64748b;text-transform:uppercase}\n.da-booking-date .da-bd-day{font-size:1.125rem;font-weight:700;color:#0f172a;line-height:1.2}\n.da-booking-info{flex:1;min-width:0}\n.da-booking-info .da-bi-name{font-weight:500;font-size:0.875rem;color:#0f172a}\n.da-booking-info .da-bi-detail{font-size:0.75rem;color:#64748b}\n.da-badge{display:inline-block;padding:0.125rem 0.5rem;border-radius:9999px;font-size:0.7rem;font-weight:500;white-space:nowrap}\n.da-badge-confirmed{background:#dcfce7;color:#166534}\n.da-badge-pending{background:#fef3c7;color:#92400e}\n.da-badge-cancelled{background:#fee2e2;color:#991b1b}\n.da-badge-high,.da-badge-urgent{background:rgba(239,68,68,0.1);color:#ef4444}\n.da-badge-medium{background:rgba(245,158,11,0.1);color:#d97706}\n.da-badge-low{background:#f1f5f9;color:#64748b}\n.da-task-icon{width:16px;height:16px;flex-shrink:0;color:#94a3b8}\n.da-task-icon.done{color:#22c55e}\n.da-task-info{flex:1;min-width:0}\n.da-task-info .da-ti-name{font-weight:500;font-size:0.875rem;color:#0f172a}\n.da-task-info .da-ti-detail{font-size:0.75rem;color:#64748b}\n.da-qa{grid-column:1/-1}\n.da-qa-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:0.75rem}\n@media(min-width:640px){.da-qa-grid{grid-template-columns:repeat(4,1fr)}}\n.da-qa-btn{display:flex;flex-direction:column;align-items:center;gap:0.5rem;padding:1rem;border:1px solid #e2e8f0;border-radius:0.75rem;background:#fff;cursor:pointer;text-decoration:none;transition:border-color .15s,box-shadow .15s}\n.da-qa-btn:hover{border-color:#0d9488;box-shadow:0 0 0 1px #0d9488}\n.da-qa-btn svg{width:20px;height:20px;color:#0d9488}\n.da-qa-btn span{font-size:0.75rem;color:#334155;text-align:center}\n.da-empty{text-align:center;padding:1.5rem;color:#94a3b8;font-size:0.875rem}\n.da-loved{margin-bottom:1.5rem}\n.da-loved h2{font-size:1.125rem;font-weight:700;color:#0f172a;margin:0 0 0.75rem}\n.da-loved-grid{display:grid;gap:1rem;grid-template-columns:repeat(auto-fill,minmax(250px,1fr))}\n.da-loved-card{background:#fff;border-radius:0.75rem;padding:1rem;box-shadow:0 1px 3px 0 rgba(0,0,0,.1);display:flex;align-items:center;gap:0.75rem;cursor:pointer;transition:box-shadow .15s;border:1px solid transparent}\n.da-loved-card:hover{box-shadow:0 4px 12px rgba(0,0,0,.1)}\n.da-loved-avatar{width:48px;height:48px;border-radius:50%;background:linear-gradient(135deg,#0d9488,#14b8a6);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:1.125rem;flex-shrink:0}\n.da-loved-name{font-weight:600;font-size:0.875rem;color:#0f172a}\n.da-loved-rel{font-size:0.75rem;color:#64748b}\n</style>\n\n<div id=\"dash-app\">\n  <!-- Header -->\n  <div class=\"da-header\">\n    <div>\n      <h1 id=\"da-welcome\">Welcome back!</h1>\n      <p>Here is your care overview and daily summary.</p>\n    </div>\n  </div>\n\n  <!-- Stats -->\n  <div class=\"da-stats\" id=\"da-stats\">\n    <div class=\"da-stat-card\"><div class=\"da-sc-inner\">\n      <svg class=\"da-sc-icon\" style=\"color:#0d9488\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"/><line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"/><line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\"/><line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"/></svg>\n      <div><div class=\"da-sc-val\" id=\"stat-bookings\">0</div><div class=\"da-sc-lbl\">Upcoming Bookings</div></div>\n    </div></div>\n    <div class=\"da-stat-card\"><div class=\"da-sc-inner\">\n      <svg class=\"da-sc-icon\" style=\"color:#22c55e\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M23 21v-2a4 4 0 0 0-3-3.87\"/><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"/></svg>\n      <div><div class=\"da-sc-val\" id=\"stat-groups\">0</div><div class=\"da-sc-lbl\">Care Teams</div></div>\n    </div></div>\n    <div class=\"da-stat-card\"><div class=\"da-sc-inner\">\n      <svg class=\"da-sc-icon\" style=\"color:#f59e0b\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"/><line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"/></svg>\n      <div><div class=\"da-sc-val\" id=\"stat-tasks\">0</div><div class=\"da-sc-lbl\">Pending Tasks</div></div>\n    </div></div>\n    <div class=\"da-stat-card\"><div class=\"da-sc-inner\">\n      <svg class=\"da-sc-icon\" style=\"color:#f97316\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"/></svg>\n      <div><div class=\"da-sc-val\" id=\"stat-messages\">0</div><div class=\"da-sc-lbl\">Unread Messages</div></div>\n    </div></div>\n  </div>\n\n  <!-- Loved Ones At a Glance -->\n  <div class=\"da-loved\" id=\"da-loved\" style=\"display:none\">\n    <h2>Loved Ones — At a Glance</h2>\n    <div class=\"da-loved-grid\" id=\"da-loved-grid\"></div>\n  </div>\n\n  <!-- 2-col grid: Bookings + Tasks -->\n  <div class=\"da-grid\">\n    <div class=\"da-card\">\n      <div class=\"da-card-hdr\">\n        <h3>Upcoming Bookings</h3>\n        <a href=\"/careconnected/bookings/\">View All <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"/><polyline points=\"12 5 19 12 12 19\"/></svg></a>\n      </div>\n      <div class=\"da-card-body\" id=\"da-bookings-list\">\n        <div class=\"da-empty\">Loading bookings...</div>\n      </div>\n    </div>\n    <div class=\"da-card\">\n      <div class=\"da-card-hdr\">\n        <h3>Care Tasks</h3>\n        <a href=\"/careconnected/care-circle/\">View All <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"/><polyline points=\"12 5 19 12 12 19\"/></svg></a>\n      </div>\n      <div class=\"da-card-body\" id=\"da-tasks-list\">\n        <div class=\"da-empty\">Loading tasks...</div>\n      </div>\n    </div>\n\n    <!-- Quick Actions (spans full width) -->\n    <div class=\"da-card da-qa\">\n      <div class=\"da-card-hdr\"><h3>Quick Actions</h3></div>\n      <div class=\"da-card-body\">\n        <div class=\"da-qa-grid\">\n          <a class=\"da-qa-btn\" href=\"/careconnected/store-listing/\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"/><line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"/><line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\"/><line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"/></svg>\n            <span>Find Help</span>\n          </a>\n          <a class=\"da-qa-btn\" href=\"/careconnected/care-circle/\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M23 21v-2a4 4 0 0 0-3-3.87\"/><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"/></svg>\n            <span>Care Teams</span>\n          </a>\n          <a class=\"da-qa-btn\" href=\"/careconnected/gps-tracking/\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"/><circle cx=\"12\" cy=\"10\" r=\"3\"/></svg>\n            <span>GPS Track</span>\n          </a>\n          <a class=\"da-qa-btn\" href=\"/careconnected/inbox/\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"/></svg>\n            <span>Messages</span>\n          </a>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\n(function(){\n  const base='/careconnected/wp-json/wp/v2';\n  let uid=null;\n\n  async function getUid(){\n    if(uid)return uid;\n    try{const r=await fetch(base+'/users/me',{credentials:'include'});if(!r.ok)return null;uid=(await r.json()).id;return uid;}catch(e){return null;}\n  }\n\n  async function loadStats(){\n    const u=await getUid();\n    if(!u){document.getElementById('da-welcome').textContent='Welcome back!';return;}\n    try{\n      const ur=await fetch(base+'/users/'+u,{credentials:'include'});\n      if(ur.ok){const ud=await ur.json();const nm=ud.name||'there';document.getElementById('da-welcome').textContent='Welcome back, '+nm.split(' ')[0]+'!';}\n    }catch(e){}\n    try{\n      const[bk,gr,tk,mg]=await Promise.all([\n        fetch(base+'/wc_booking?author='+u+'&per_page=1',{credentials:'include'}),\n        fetch(base+'/care_group?author='+u+'&per_page=1',{credentials:'include'}),\n        fetch(base+'/care_task?author='+u+'&per_page=1',{credentials:'include'}),\n        fetch(base+'/chat_message?per_page=1',{credentials:'include'})\n      ]);\n      document.getElementById('stat-bookings').textContent=bk.headers.get('X-WP-Total')||'0';\n      document.getElementById('stat-groups').textContent=gr.headers.get('X-WP-Total')||'0';\n      document.getElementById('stat-tasks').textContent=tk.headers.get('X-WP-Total')||'0';\n      document.getElementById('stat-messages').textContent=mg.headers.get('X-WP-Total')||'0';\n    }catch(e){console.error(e);}\n  }\n\n  async function loadBookings(){\n    const u=await getUid();const el=document.getElementById('da-bookings-list');\n    if(!u){el.innerHTML='<div class=\"da-empty\">Sign in to view bookings</div>';return;}\n    try{\n      const r=await fetch(base+'/wc_booking?author='+u+'&per_page=3&orderby=date&order=asc',{credentials:'include'});\n      const bks=r.ok?await r.json():[];\n      if(!bks.length){el.innerHTML='<div class=\"da-empty\">No upcoming bookings</div>';return;}\n      el.innerHTML=bks.map(b=>{\n        const d=new Date(b.date);\n        const mo=d.toLocaleDateString('en',{month:'short'});\n        const dy=d.getDate();\n        const title=b.title?.rendered||'Booking';\n        const st=b.status||'pending';\n        const time=b.meta?._booking_start||'';\n        const svc=b.meta?.service_type||'';\n        return '<div class=\"da-booking-row\"><div class=\"da-booking-date\"><div class=\"da-bd-month\">'+mo+'</div><div class=\"da-bd-day\">'+dy+'</div></div><div class=\"da-booking-info\"><div class=\"da-bi-name\">'+title+'</div><div class=\"da-bi-detail\">'+[time,svc].filter(Boolean).join(' · ')+'</div></div><span class=\"da-badge da-badge-'+st+'\">'+st+'</span></div>';\n      }).join('');\n    }catch(e){el.innerHTML='<div class=\"da-empty\">Failed to load</div>';}\n  }\n\n  async function loadTasks(){\n    const u=await getUid();const el=document.getElementById('da-tasks-list');\n    if(!u){el.innerHTML='<div class=\"da-empty\">Sign in to view tasks</div>';return;}\n    try{\n      const r=await fetch(base+'/care_task?author='+u+'&per_page=4&orderby=date&order=desc',{credentials:'include'});\n      const tks=r.ok?await r.json():[];\n      if(!tks.length){el.innerHTML='<div class=\"da-empty\">No pending tasks</div>';return;}\n      el.innerHTML=tks.map(t=>{\n        const title=t.title?.rendered||'Task';\n        const pri=t.meta?.priority||'medium';\n        const done=t.status==='completed';\n        const assignee=t.meta?.assignee_name||'Unassigned';\n        const due=t.meta?.due_date?new Date(t.meta.due_date).toLocaleDateString('en',{month:'short',day:'numeric'}):'';\n        const iconCls=done?'da-task-icon done':'da-task-icon';\n        return '<div class=\"da-task-row\"><svg class=\"'+iconCls+'\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"/><polyline points=\"22 4 12 14.01 9 11.01\"/></svg><div class=\"da-task-info\"><div class=\"da-ti-name\">'+title+'</div><div class=\"da-ti-detail\">'+assignee+(due?' · Due '+due:'')+'</div></div><span class=\"da-badge da-badge-'+pri+'\">'+pri+'</span></div>';\n      }).join('');\n    }catch(e){el.innerHTML='<div class=\"da-empty\">Failed to load</div>';}\n  }\n\n  async function loadLoved(){\n    const u=await getUid();if(!u)return;\n    try{\n      const r=await fetch(base+'/cared_one?author='+u+'&per_page=6',{credentials:'include'});\n      const cos=r.ok?await r.json():[];\n      if(!cos.length)return;\n      const el=document.getElementById('da-loved');el.style.display='block';\n      const grid=document.getElementById('da-loved-grid');\n      grid.innerHTML=cos.map(c=>{\n        const nm=c.title?.rendered||'Loved One';\n        const rel=c.meta?.relationship||'';\n        const init=nm.charAt(0).toUpperCase();\n        return '<a class=\"da-loved-card\" href=\"/careconnected/cared-ones/\"><div class=\"da-loved-avatar\">'+init+'</div><div><div class=\"da-loved-name\">'+nm+'</div><div class=\"da-loved-rel\">'+rel+'</div></div></a>';\n      }).join('');\n    }catch(e){}\n  }\n\n  loadStats();loadBookings();loadTasks();loadLoved();\n})();\n</script>\n<!-- /wp:html --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->", "status": "publish", "id": 24}