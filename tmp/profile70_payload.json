{"content": "<!-- wp:columns {\"isStackedOnMobile\":false} -->\n<div class=\"wp-block-columns is-not-stacked-on-mobile\"><!-- wp:column {\"width\":\"220px\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:220px\"><!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"1rem\",\"right\":\"0.75rem\",\"bottom\":\"1rem\",\"left\":\"0.75rem\"}},\"border\":{\"right\":{\"color\":\"#e5e7eb\",\"width\":\"1px\"}}},\"backgroundColor\":\"base\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group has-base-background-color has-background\" style=\"border-right-color:#e5e7eb;border-right-width:1px;padding-top:1rem;padding-right:0.75rem;padding-bottom:1rem;padding-left:0.75rem\"><!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/dashboard/\">🏠 Dashboard</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/profile/\">👤 My Profile</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/notifications/\">🔔 Notifications</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column -->\n<!-- wp:column {\"style\":{\"color\":{\"background\":\"#f9fafb\"}}} -->\n<div class=\"wp-block-column has-background\" style=\"background-color:#f9fafb\">\n<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"right\":\"1.5rem\",\"left\":\"1.5rem\",\"bottom\":\"1.5rem\"}}}} -->\n<div class=\"wp-block-group\" style=\"padding-right:1.5rem;padding-left:1.5rem;padding-bottom:1.5rem\">\n<!-- wp:html -->\n<style>\n#profile70-shell{max-width:48rem;margin:0 auto;padding:1.5rem 1rem;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}\n#profile70-shell *{box-sizing:border-box}\n#profile70-shell h1{font-size:1.5rem;font-weight:700;color:#0f172a;margin:0 0 1.5rem}\n#profile70-shell .p70-tabs{display:flex;gap:0;background:#f1f5f9;border-radius:.5rem;padding:.25rem;margin-bottom:1.5rem;width:fit-content}\n#profile70-shell .p70-tab{display:inline-flex;align-items:center;gap:.5rem;padding:.5rem 1rem;border-radius:.375rem;font-size:.8125rem;font-weight:500;cursor:pointer;border:none;background:transparent;color:#64748b}\n#profile70-shell .p70-tab.active{background:#fff;color:#0f172a;box-shadow:0 1px 2px rgba(0,0,0,.05)}\n#profile70-shell .p70-tab svg{width:16px;height:16px}\n.p70-panel{display:none}\n.p70-panel.active{display:block}\n</style>\n<div id=\"profile70-shell\">\n  <h1>My Profile</h1>\n  <div class=\"p70-tabs\">\n    <button class=\"p70-tab active\" data-tab=\"personal\" type=\"button\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2\"></path><circle cx=\"12\" cy=\"7\" r=\"4\"></circle></svg> Personal</button>\n    <button class=\"p70-tab\" data-tab=\"notifications\" type=\"button\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9\"></path><path d=\"M13.73 21a2 2 0 0 1-3.46 0\"></path></svg> Notifications</button>\n    <button class=\"p70-tab\" data-tab=\"privacy\" type=\"button\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"></path></svg> Privacy</button>\n  </div>\n</div>\n<script>\n(function(){\n  const base='/careconnected/wp-json/wp/v2';\n  const state={tab:'personal',user:null,listeners:{}};\n  function emit(name){(state.listeners[name]||[]).forEach(fn=>{try{fn(state)}catch(e){}})}\n  function on(name,fn){state.listeners[name]=state.listeners[name]||[];state.listeners[name].push(fn);return()=>state.listeners[name]=(state.listeners[name]||[]).filter(x=>x!==fn)}\n  function setTab(tab){state.tab=tab;document.querySelectorAll('#profile70-shell .p70-tab').forEach(btn=>btn.classList.toggle('active',btn.dataset.tab===tab));document.querySelectorAll('.p70-panel').forEach(p=>p.classList.toggle('active',p.dataset-panel===tab));emit('tab')}\n  async function load(){try{const r=await fetch(base+'/users/me?context=edit',{credentials:'include'});state.user=r.ok?await r.json():null}catch(e){state.user=null}emit('data')}\n  function nonce(){return document.querySelector('meta[name=\"wp-nonce\"]')?.content||''}\n  async function save(payload){await fetch(base+'/users/me',{method:'POST',credentials:'include',headers:{'Content-Type':'application/json','X-WP-Nonce':nonce()},body:JSON.stringify(payload)});await load()}\n  window.__profile70={state,on,emit,setTab,load,save};\n  document.querySelectorAll('#profile70-shell .p70-tab').forEach(btn=>btn.addEventListener('click',()=>setTab(btn.dataset.tab)));\n  setTab('personal');\n  load();\n})();\n</script>\n<!-- /wp:html -->\n<!-- wp:html -->\n<style>\n#profile70-summary{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}\n#profile70-summary .p70-card{background:#fff;border-radius:.75rem;box-shadow:0 1px 3px rgba(0,0,0,.1);border:1px solid transparent;margin-bottom:1rem}\n#profile70-summary .p70-card-body{padding:1.5rem}\n#profile70-summary .p70-row{display:flex;align-items:center;gap:1.5rem}\n#profile70-summary .p70-avatar{width:80px;height:80px;border-radius:1rem;background:#0d9488;display:flex;align-items:center;justify-content:center;font-size:1.5rem;font-weight:700;color:#fff;flex-shrink:0;overflow:hidden}\n#profile70-summary .p70-avatar img{width:100%;height:100%;object-fit:cover}\n#profile70-summary .p70-name{font-size:1.125rem;font-weight:600;color:#0f172a}\n#profile70-summary .p70-email{font-size:.875rem;color:#64748b}\n#profile70-summary .p70-role{font-size:.75rem;color:#94a3b8;margin-top:.25rem}\n#profile70-summary .p70-empty{padding:1rem;color:#94a3b8;font-size:.875rem}\n</style>\n<div id=\"profile70-summary\" class=\"p70-panel active\" data-panel=\"personal\">\n  <div class=\"p70-card\"><div class=\"p70-card-body\"><div class=\"p70-empty\">Loading profile...</div></div></div>\n</div>\n<script>\n(function(){\n  const root=document.getElementById('profile70-summary');\n  function render(){\n    const api=window.__profile70;if(!api)return; const u=api.state.user;\n    if(!u){root.innerHTML='<div class=\"p70-card\"><div class=\"p70-card-body\"><div class=\"p70-empty\">Unable to load profile</div></div></div>';return}\n    const name=u.name||'User'; const email=u.email||''; const roles=u.roles||[]; const role=(roles.includes('seller')||roles.includes('vendor'))?'Care Provider':'Care Seeker';\n    const avatar=u.avatar_urls?.['96']||'';\n    root.innerHTML='<div class=\"p70-card\"><div class=\"p70-card-body\"><div class=\"p70-row\"><div class=\"p70-avatar\">'+(avatar?'<img src=\"'+avatar+'\" alt=\"\">':name.charAt(0).toUpperCase())+'</div><div><div class=\"p70-name\">'+name+'</div><div class=\"p70-email\">'+email+'</div><div class=\"p70-role\">'+role+'</div></div></div></div></div>';\n  }\n  function bind(){const api=window.__profile70;if(!api)return false;api.on('data',render);api.on('tab',render);render();return true}\n  if(!bind()){const t=setInterval(()=>{if(bind())clearInterval(t)},200)}\n})();\n</script>\n<!-- /wp:html -->\n<!-- wp:html -->\n<style>\n#profile70-personal{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}\n#profile70-personal .p70-card{background:#fff;border-radius:.75rem;box-shadow:0 1px 3px rgba(0,0,0,.1);border:1px solid transparent;margin-bottom:1rem}\n#profile70-personal .p70-card-hdr{padding:1.25rem 1.5rem 0;font-weight:600;font-size:1rem;color:#0f172a}\n#profile70-personal .p70-card-body{padding:1.5rem}\n#profile70-personal .p70-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}\n@media(max-width:640px){#profile70-personal .p70-grid{grid-template-columns:1fr}}\n#profile70-personal .p70-label{display:block;margin-bottom:.25rem;font-size:.8125rem;font-weight:500;color:#334155}\n#profile70-personal .p70-input,#profile70-personal .p70-textarea{width:100%;padding:.5rem .75rem;border:1px solid #e2e8f0;border-radius:.5rem;font-size:.875rem;outline:none;background:#fff;font-family:inherit}\n#profile70-personal .p70-input:focus,#profile70-personal .p70-textarea:focus{border-color:#0d9488;box-shadow:0 0 0 2px rgba(13,148,136,.08)}\n#profile70-personal .p70-textarea{resize:vertical}\n#profile70-personal .p70-icon-wrap{position:relative}.p70-icon-wrap svg{position:absolute;left:.75rem;top:50%;transform:translateY(-50%);width:16px;height:16px;color:#94a3b8}.p70-icon-wrap input{padding-left:2.25rem}\n#profile70-personal .p70-btn{display:inline-flex;align-items:center;gap:.5rem;padding:.5rem 1rem;border:none;border-radius:.5rem;font-size:.875rem;font-weight:500;cursor:pointer;background:#0d9488;color:#fff}\n#profile70-personal .p70-empty{padding:1rem;color:#94a3b8;font-size:.875rem}\n</style>\n<div id=\"profile70-personal\" class=\"p70-panel active\" data-panel=\"personal\">\n  <div class=\"p70-card\"><div class=\"p70-card-hdr\">Personal Information</div><div class=\"p70-card-body\"><div class=\"p70-empty\">Loading form...</div></div></div>\n</div>\n<script>\n(function(){\n  const root=document.getElementById('profile70-personal');\n  function esc(v){return String(v||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;')}\n  function render(){\n    const api=window.__profile70;if(!api)return; const u=api.state.user;\n    if(!u){root.innerHTML='<div class=\"p70-card\"><div class=\"p70-card-body\"><div class=\"p70-empty\">Unable to load form</div></div></div>';return}\n    root.innerHTML='<div class=\"p70-card\"><div class=\"p70-card-hdr\">Personal Information</div><div class=\"p70-card-body\"><div class=\"p70-grid\"><div><label class=\"p70-label\">Full Name</label><input class=\"p70-input\" id=\"p70-name\" value=\"'+esc(u.name)+'\"></div><div><label class=\"p70-label\">Email</label><input class=\"p70-input\" id=\"p70-email\" value=\"'+esc(u.email)+'\" disabled></div><div><label class=\"p70-label\">Phone</label><input class=\"p70-input\" id=\"p70-phone\" value=\"'+esc(u.meta?.phone_number||'')+'\"></div><div><label class=\"p70-label\">Avatar URL</label><input class=\"p70-input\" id=\"p70-avatar\" value=\"'+esc(u.avatar_urls?.['96']||'')+'\"></div></div><div style=\"margin-top:1rem\"><label class=\"p70-label\">Address</label><div class=\"p70-icon-wrap\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg><input class=\"p70-input\" id=\"p70-address\" value=\"'+esc(u.meta?.address||'')+'\"></div></div><div style=\"margin-top:1rem\"><label class=\"p70-label\">About Me</label><textarea class=\"p70-textarea\" id=\"p70-bio\" rows=\"3\">'+esc(u.description||'')+'</textarea></div><div style=\"margin-top:1rem\"><button class=\"p70-btn\" type=\"button\" id=\"p70-save-personal\">Save Changes</button></div></div></div>';\n    document.getElementById('p70-save-personal').addEventListener('click',async()=>{\n      const btn=document.getElementById('p70-save-personal'); btn.textContent='Saving...';\n      try{await api.save({name:document.getElementById('p70-name').value,description:document.getElementById('p70-bio').value,meta:{phone_number:document.getElementById('p70-phone').value,address:document.getElementById('p70-address').value}});btn.textContent='Save Changes'}catch(e){btn.textContent='Save Changes';alert('Failed to save profile')}\n    });\n  }\n  function bind(){const api=window.__profile70;if(!api)return false;api.on('data',render);api.on('tab',render);render();return true}\n  if(!bind()){const t=setInterval(()=>{if(bind())clearInterval(t)},200)}\n})();\n</script>\n<!-- /wp:html -->\n<!-- wp:html -->\n<style>\n#profile70-notifs{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}\n#profile70-notifs .p70-card{background:#fff;border-radius:.75rem;box-shadow:0 1px 3px rgba(0,0,0,.1);border:1px solid transparent;margin-bottom:1rem}\n#profile70-notifs .p70-card-hdr{padding:1.25rem 1.5rem 0;font-weight:600;font-size:1rem;color:#0f172a}\n#profile70-notifs .p70-card-body{padding:1.5rem}\n#profile70-notifs .p70-row{display:flex;align-items:center;justify-content:space-between;padding:.5rem 0}\n#profile70-notifs .p70-label{font-size:.875rem;color:#334155}\n#profile70-notifs .p70-switch{width:44px;height:24px;border-radius:12px;background:#e2e8f0;position:relative;cursor:pointer;border:none;transition:background .2s;flex-shrink:0}\n#profile70-notifs .p70-switch.on{background:#0d9488}\n#profile70-notifs .p70-switch::after{content:'';position:absolute;top:2px;left:2px;width:20px;height:20px;border-radius:50%;background:#fff;transition:transform .2s;box-shadow:0 1px 2px rgba(0,0,0,.1)}\n#profile70-notifs .p70-switch.on::after{transform:translateX(20px)}\n#profile70-notifs .p70-btn{display:inline-flex;align-items:center;gap:.5rem;padding:.5rem 1rem;border:none;border-radius:.5rem;font-size:.875rem;font-weight:500;cursor:pointer;background:#0d9488;color:#fff}\n#profile70-notifs .p70-empty{padding:1rem;color:#94a3b8;font-size:.875rem}\n</style>\n<div id=\"profile70-notifs\" class=\"p70-panel\" data-panel=\"notifications\">\n  <div class=\"p70-card\"><div class=\"p70-card-hdr\">Notification Preferences</div><div class=\"p70-card-body\"><div class=\"p70-empty\">Loading preferences...</div></div></div>\n</div>\n<script>\n(function(){\n  const root=document.getElementById('profile70-notifs');\n  function render(){\n    const api=window.__profile70;if(!api)return; const u=api.state.user;\n    if(!u){root.innerHTML='<div class=\"p70-card\"><div class=\"p70-card-body\"><div class=\"p70-empty\">Unable to load preferences</div></div></div>';return}\n    const emailOn=(u.meta?.email_notification ?? true); const pushOn=(u.meta?.push_notification ?? true);\n    root.innerHTML='<div class=\"p70-card\"><div class=\"p70-card-hdr\">Notification Preferences</div><div class=\"p70-card-body\"><div class=\"p70-row\"><div class=\"p70-label\">Email Notifications</div><button class=\"p70-switch '+(emailOn?'on':'')+'\" type=\"button\" id=\"p70-email-switch\"></button></div><div class=\"p70-row\"><div class=\"p70-label\">Push Notifications</div><button class=\"p70-switch '+(pushOn?'on':'')+'\" type=\"button\" id=\"p70-push-switch\"></button></div><div style=\"margin-top:1rem\"><button class=\"p70-btn\" type=\"button\" id=\"p70-save-notifs\">Save Preferences</button></div></div></div>';\n    document.getElementById('p70-email-switch').addEventListener('click',e=>e.currentTarget.classList.toggle('on'));\n    document.getElementById('p70-push-switch').addEventListener('click',e=>e.currentTarget.classList.toggle('on'));\n    document.getElementById('p70-save-notifs').addEventListener('click',async()=>{\n      const btn=document.getElementById('p70-save-notifs'); btn.textContent='Saving...';\n      try{await api.save({meta:{email_notification:document.getElementById('p70-email-switch').classList.contains('on'),push_notification:document.getElementById('p70-push-switch').classList.contains('on')}});btn.textContent='Save Preferences'}catch(e){btn.textContent='Save Preferences';alert('Failed to save preferences')}\n    });\n  }\n  function bind(){const api=window.__profile70;if(!api)return false;api.on('data',render);api.on('tab',render);render();return true}\n  if(!bind()){const t=setInterval(()=>{if(bind())clearInterval(t)},200)}\n})();\n</script>\n<!-- /wp:html -->\n<!-- wp:html -->\n<style>\n#profile70-privacy{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}\n#profile70-privacy .p70-card{background:#fff;border-radius:.75rem;box-shadow:0 1px 3px rgba(0,0,0,.1);border:1px solid transparent;margin-bottom:1rem}\n#profile70-privacy .p70-danger{border-color:rgba(239,68,68,.2)}\n#profile70-privacy .p70-card-hdr{padding:1.25rem 1.5rem 0;font-weight:600;font-size:1rem;color:#0f172a}\n#profile70-privacy .p70-danger .p70-card-hdr{color:#ef4444}\n#profile70-privacy .p70-card-body{padding:1.5rem}\n#profile70-privacy .p70-desc{font-size:.8125rem;color:#64748b;margin:0 0 .75rem}\n#profile70-privacy .p70-btn{display:inline-flex;align-items:center;gap:.5rem;padding:.5rem 1rem;border:none;border-radius:.5rem;font-size:.875rem;font-weight:500;cursor:pointer}\n#profile70-privacy .p70-outline{background:#fff;color:#334155;border:1px solid #e2e8f0;width:100%}\n#profile70-privacy .p70-destructive{background:#ef4444;color:#fff;width:100%}\n</style>\n<div id=\"profile70-privacy\" class=\"p70-panel\" data-panel=\"privacy\">\n  <div class=\"p70-card\"><div class=\"p70-card-hdr\">Your Data</div><div class=\"p70-card-body\"><p class=\"p70-desc\">Download a copy of your account data.</p><button class=\"p70-btn p70-outline\" type=\"button\" id=\"p70-download\">Download My Data</button></div></div>\n  <div class=\"p70-card p70-danger\"><div class=\"p70-card-hdr\">Danger Zone</div><div class=\"p70-card-body\"><p class=\"p70-desc\">Permanently delete your account and associated data. This action cannot be undone.</p><button class=\"p70-btn p70-destructive\" type=\"button\" id=\"p70-delete\">Delete Account</button></div></div>\n</div>\n<script>\n(function(){\n  const root=document.getElementById('profile70-privacy');\n  function bind(){const api=window.__profile70;if(!api)return false;\n    root.querySelector('#p70-download').addEventListener('click',()=>{\n      const u=api.state.user||{}; const blob=new Blob([JSON.stringify({exported_at:new Date().toISOString(),profile:u},null,2)],{type:'application/json'}); const url=URL.createObjectURL(blob); const a=document.createElement('a'); a.href=url; a.download='careconnected-data-'+new Date().toISOString().split('T')[0]+'.json'; document.body.appendChild(a); a.click(); document.body.removeChild(a); URL.revokeObjectURL(url);\n    });\n    root.querySelector('#p70-delete').addEventListener('click',()=>{alert('Account deletion must be completed through the configured backend flow.');});\n    return true}\n  if(!bind()){const t=setInterval(()=>{if(bind())clearInterval(t)},200)}\n})();\n</script>\n<!-- /wp:html -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->", "status": "publish"}