{"content": "<!-- wp:columns {\"isStackedOnMobile\":false} -->\n<div class=\"wp-block-columns is-not-stacked-on-mobile\"><!-- wp:column {\"width\":\"220px\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:220px\"><!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"1rem\",\"right\":\"0.75rem\",\"bottom\":\"1rem\",\"left\":\"0.75rem\"}},\"border\":{\"right\":{\"color\":\"#e5e7eb\",\"width\":\"1px\"}}},\"backgroundColor\":\"base\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group has-base-background-color has-background\" style=\"border-right-color:#e5e7eb;border-right-width:1px;padding-top:1rem;padding-right:0.75rem;padding-bottom:1rem;padding-left:0.75rem\"><!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/dashboard/\">🏠 Dashboard</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/notifications/\">🔔 Notifications</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column -->\n<!-- wp:column {\"style\":{\"color\":{\"background\":\"#f9fafb\"}}} -->\n<div class=\"wp-block-column has-background\" style=\"background-color:#f9fafb\">\n<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"right\":\"1.5rem\",\"left\":\"1.5rem\",\"bottom\":\"1.5rem\"}}}} -->\n<div class=\"wp-block-group\" style=\"padding-right:1.5rem;padding-left:1.5rem;padding-bottom:1.5rem\">\n<!-- wp:html -->\n<style>\n#notif70-shell{max-width:48rem;margin:0 auto;padding:1.5rem 1rem;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}\n#notif70-shell *{box-sizing:border-box}\n#notif70-shell .n70-header{display:flex;align-items:center;justify-content:space-between;gap:.75rem;flex-wrap:wrap;margin-bottom:1.5rem}\n#notif70-shell .n70-header h1{font-size:1.5rem;font-weight:700;color:#0f172a;margin:0}\n#notif70-shell .n70-header p{margin:.25rem 0 0;font-size:.875rem;color:#64748b}\n#notif70-shell .n70-link{font-size:.8125rem;color:#0d9488;background:none;border:none;cursor:pointer;font-weight:500}\n#notif70-shell .n70-tabs{display:flex;gap:0;background:#f1f5f9;border-radius:.5rem;padding:.25rem;margin-bottom:1rem;width:fit-content}\n#notif70-shell .n70-tab{padding:.5rem 1rem;border:none;border-radius:.375rem;background:transparent;color:#64748b;font-size:.8125rem;font-weight:500;cursor:pointer}\n#notif70-shell .n70-tab.active{background:#fff;color:#0f172a;box-shadow:0 1px 2px rgba(0,0,0,.05)}\n.n70-panel{display:none}\n.n70-panel.active{display:block}\n</style>\n<div id=\"notif70-shell\">\n  <div class=\"n70-header\">\n    <div>\n      <h1>Notifications</h1>\n      <p>Stay updated on your care activities</p>\n    </div>\n    <button class=\"n70-link\" type=\"button\" id=\"notif70-mark-all\">Mark all as read</button>\n  </div>\n  <div class=\"n70-tabs\">\n    <button class=\"n70-tab active\" data-tab=\"all\" type=\"button\">All</button>\n    <button class=\"n70-tab\" data-tab=\"invitations\" type=\"button\">Invitations</button>\n  </div>\n</div>\n<script>\n(function(){\n  const base='/careconnected/wp-json/wp/v2';\n  const state={tab:'all',items:[],listeners:{}};\n  function emit(name){(state.listeners[name]||[]).forEach(fn=>{try{fn(state)}catch(e){}})}\n  function on(name,fn){state.listeners[name]=state.listeners[name]||[];state.listeners[name].push(fn);return()=>state.listeners[name]=(state.listeners[name]||[]).filter(x=>x!==fn)}\n  function setTab(tab){state.tab=tab;document.querySelectorAll('#notif70-shell .n70-tab').forEach(b=>b.classList.toggle('active',b.dataset.tab===tab));document.querySelectorAll('.n70-panel').forEach(p=>p.classList.toggle('active',p.dataset-panel===tab));emit('tab')}\n  function nonce(){return document.querySelector('meta[name=\"wp-nonce\"]')?.content||''}\n  async function load(){try{const r=await fetch(base+'/notification?per_page=50&orderby=date&order=desc',{credentials:'include'});state.items=r.ok?await r.json():[]}catch(e){state.items=[]}emit('data')}\n  async function update(id,payload){await fetch(base+'/notification/'+id,{method:'POST',credentials:'include',headers:{'Content-Type':'application/json','X-WP-Nonce':nonce()},body:JSON.stringify(payload)});await load()}\n  async function markAll(){const unread=(state.items||[]).filter(n=>!n.meta?.is_read);for(const item of unread){await update(item.id,{meta:{...(item.meta||{}),is_read:true}})}}\n  window.__notif70={state,on,emit,setTab,load,update,markAll};\n  document.querySelectorAll('#notif70-shell .n70-tab').forEach(btn=>btn.addEventListener('click',()=>setTab(btn.dataset.tab)));\n  document.getElementById('notif70-mark-all').addEventListener('click',()=>markAll());\n  setTab('all');\n  load();\n})();\n</script>\n<!-- /wp:html -->\n<!-- wp:html -->\n<style>\n#notif70-all{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}\n#notif70-all .n70-card{background:#fff;border-radius:.75rem;box-shadow:0 1px 3px rgba(0,0,0,.1);border:1px solid transparent;padding:1rem 1.25rem;margin-bottom:.75rem;display:flex;align-items:flex-start;gap:.75rem}\n#notif70-all .n70-card.unread{border-left:3px solid #0d9488;background:#f0fdf4}\n#notif70-all .n70-icon{width:40px;height:40px;border-radius:.75rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:1.125rem}\n#notif70-all .n70-system{background:rgba(100,116,139,.1);color:#64748b}\n#notif70-all .n70-booking{background:rgba(59,130,246,.1);color:#3b82f6}\n#notif70-all .n70-task{background:rgba(245,158,11,.1);color:#f59e0b}\n#notif70-all .n70-message{background:rgba(13,148,136,.1);color:#0d9488}\n#notif70-all .n70-invite{background:rgba(168,85,247,.1);color:#a855f7}\n#notif70-all .n70-body{flex:1;min-width:0}\n#notif70-all .n70-title{font-size:.9375rem;font-weight:500;color:#0f172a;margin:0 0 .25rem}\n#notif70-all .n70-desc{font-size:.8125rem;color:#64748b;margin:0}\n#notif70-all .n70-time{font-size:.7rem;color:#94a3b8;margin-top:.25rem}\n#notif70-all .n70-action{margin-top:.5rem;background:none;border:none;color:#64748b;font-size:.75rem;cursor:pointer;padding:0}\n#notif70-all .n70-empty{text-align:center;padding:3rem 1rem;color:#94a3b8;font-size:.875rem}\n</style>\n<div id=\"notif70-all\" class=\"n70-panel active\" data-panel=\"all\">\n  <div class=\"n70-empty\">Loading notifications...</div>\n</div>\n<script>\n(function(){\n  const root=document.getElementById('notif70-all');\n  const typeClass={booking:'n70-booking',booking_rescheduled:'n70-booking',task:'n70-task',message:'n70-message',care_group_invite:'n70-invite',default:'n70-system'};\n  const typeEmoji={booking:'📅',booking_rescheduled:'📅',task:'✅',message:'💬',care_group_invite:'👥',default:'🔔'};\n  function timeAgo(d){const s=Math.floor((Date.now()-new Date(d).getTime())/1000);if(s<60)return'Just now';if(s<3600)return Math.floor(s/60)+'m ago';if(s<86400)return Math.floor(s/3600)+'h ago';return Math.floor(s/86400)+'d ago'}\n  function strip(v){return (v||'').replace(/<[^>]*>/g,'')}\n  function render(){\n    const api=window.__notif70;if(!api)return; const items=(api.state.items||[]);\n    if(!items.length){root.innerHTML='<div class=\"n70-empty\">No notifications yet</div>';return}\n    root.innerHTML=items.map(n=>{\n      const type=n.meta?.type||'default'; const isRead=!!n.meta?.is_read;\n      const mark=!isRead?'<button class=\"n70-action\" type=\"button\" onclick=\"window.__notif70.update('+n.id+',{meta:{...(window.__notif70.state.items.find(x=>x.id=='+n.id+')?.meta||{}),is_read:true}})\">Mark as read</button>':'';\n      return '<div class=\"n70-card '+(isRead?'':'unread')+'\"><div class=\"n70-icon '+(typeClass[type]||'n70-system')+'\">'+(typeEmoji[type]||'🔔')+'</div><div class=\"n70-body\"><h3 class=\"n70-title\">'+(n.title?.rendered||'Notification')+'</h3><p class=\"n70-desc\">'+strip(n.content?.rendered||'')+'</p><div class=\"n70-time\">'+timeAgo(n.date)+'</div>'+mark+'</div></div>';\n    }).join('');\n  }\n  function bind(){const api=window.__notif70;if(!api)return false;api.on('data',render);api.on('tab',render);render();return true}\n  if(!bind()){const t=setInterval(()=>{if(bind())clearInterval(t)},200)}\n})();\n</script>\n<!-- /wp:html -->\n<!-- wp:html -->\n<style>\n#notif70-invitations{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}\n#notif70-invitations .n70-card{background:#fff;border-radius:.75rem;box-shadow:0 1px 3px rgba(0,0,0,.1);border:1px solid transparent;padding:1rem 1.25rem;margin-bottom:.75rem;display:flex;align-items:flex-start;gap:.75rem}\n#notif70-invitations .n70-icon{width:40px;height:40px;border-radius:.75rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:1.125rem;background:rgba(168,85,247,.1);color:#a855f7}\n#notif70-invitations .n70-body{flex:1;min-width:0}\n#notif70-invitations .n70-title{font-size:.9375rem;font-weight:500;color:#0f172a;margin:0 0 .25rem}\n#notif70-invitations .n70-desc{font-size:.8125rem;color:#64748b;margin:0}\n#notif70-invitations .n70-time{font-size:.7rem;color:#94a3b8;margin-top:.25rem}\n#notif70-invitations .n70-actions{display:flex;gap:.5rem;margin-top:.5rem}\n#notif70-invitations .n70-btn{display:inline-flex;align-items:center;gap:.375rem;padding:.375rem .75rem;border:none;border-radius:.375rem;font-size:.75rem;font-weight:500;cursor:pointer}\n#notif70-invitations .n70-accept{background:#0d9488;color:#fff}\n#notif70-invitations .n70-decline{background:#fff;color:#ef4444;border:1px solid rgba(239,68,68,.3)}\n#notif70-invitations .n70-empty{text-align:center;padding:3rem 1rem;color:#94a3b8;font-size:.875rem}\n</style>\n<div id=\"notif70-invitations\" class=\"n70-panel\" data-panel=\"invitations\">\n  <div class=\"n70-empty\">Loading invitations...</div>\n</div>\n<script>\n(function(){\n  const root=document.getElementById('notif70-invitations');\n  function timeAgo(d){const s=Math.floor((Date.now()-new Date(d).getTime())/1000);if(s<60)return'Just now';if(s<3600)return Math.floor(s/60)+'m ago';if(s<86400)return Math.floor(s/3600)+'h ago';return Math.floor(s/86400)+'d ago'}\n  function strip(v){return (v||'').replace(/<[^>]*>/g,'')}\n  function render(){\n    const api=window.__notif70;if(!api)return;\n    const items=(api.state.items||[]).filter(n=>(n.meta?.type||'')==='care_group_invite' && !n.meta?.responded);\n    if(!items.length){root.innerHTML='<div class=\"n70-empty\">No pending invitations</div>';return}\n    root.innerHTML=items.map(n=>{\n      return '<div class=\"n70-card\"><div class=\"n70-icon\">👥</div><div class=\"n70-body\"><h3 class=\"n70-title\">'+(n.title?.rendered||'Invitation')+'</h3><p class=\"n70-desc\">'+strip(n.content?.rendered||'')+'</p><div class=\"n70-time\">'+timeAgo(n.date)+'</div><div class=\"n70-actions\"><button class=\"n70-btn n70-accept\" type=\"button\" onclick=\"window.__notif70.update('+n.id+',{meta:{...(window.__notif70.state.items.find(x=>x.id=='+n.id+')?.meta||{}),responded:true,response:\\'accept\\',is_read:true}})\">Accept</button><button class=\"n70-btn n70-decline\" type=\"button\" onclick=\"window.__notif70.update('+n.id+',{meta:{...(window.__notif70.state.items.find(x=>x.id=='+n.id+')?.meta||{}),responded:true,response:\\'decline\\',is_read:true}})\">Decline</button></div></div></div>';\n    }).join('');\n  }\n  function bind(){const api=window.__notif70;if(!api)return false;api.on('data',render);api.on('tab',render);render();return true}\n  if(!bind()){const t=setInterval(()=>{if(bind())clearInterval(t)},200)}\n})();\n</script>\n<!-- /wp:html -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->", "status": "publish"}