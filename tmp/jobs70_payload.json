{"content": "<!-- wp:columns {\"isStackedOnMobile\":false} -->\n<div class=\"wp-block-columns is-not-stacked-on-mobile\"><!-- wp:column {\"width\":\"220px\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:220px\"><!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"1rem\",\"right\":\"0.75rem\",\"bottom\":\"1rem\",\"left\":\"0.75rem\"}},\"border\":{\"right\":{\"color\":\"#e5e7eb\",\"width\":\"1px\"}}},\"backgroundColor\":\"base\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group has-base-background-color has-background\" style=\"border-right-color:#e5e7eb;border-right-width:1px;padding-top:1rem;padding-right:0.75rem;padding-bottom:1rem;padding-left:0.75rem\"><!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/dashboard/\">🏠 Dashboard</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/jobs/\">💼 Jobs Board</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/profile/\">👤 My Profile</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column -->\n<!-- wp:column {\"style\":{\"color\":{\"background\":\"#f9fafb\"}}} -->\n<div class=\"wp-block-column has-background\" style=\"background-color:#f9fafb\">\n<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"right\":\"1.5rem\",\"left\":\"1.5rem\",\"bottom\":\"1.5rem\"}}}} -->\n<div class=\"wp-block-group\" style=\"padding-right:1.5rem;padding-left:1.5rem;padding-bottom:1.5rem\">\n<!-- wp:html -->\n<style>\n#jobs70-shell{max-width:64rem;margin:0 auto;padding:1.5rem 1rem;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}\n#jobs70-shell *{box-sizing:border-box}\n#jobs70-shell .j70-header{display:flex;align-items:center;justify-content:space-between;gap:.75rem;flex-wrap:wrap;margin-bottom:1.5rem}\n#jobs70-shell .j70-header h1{font-size:1.5rem;font-weight:700;color:#0f172a;margin:0}\n#jobs70-shell .j70-header p{margin:.25rem 0 0;font-size:.875rem;color:#64748b}\n#jobs70-shell .j70-btn{display:inline-flex;align-items:center;gap:.5rem;padding:.5rem 1rem;border:none;border-radius:.5rem;font-size:.875rem;font-weight:500;cursor:pointer;text-decoration:none;transition:opacity .15s}\n#jobs70-shell .j70-btn:hover{opacity:.9}\n#jobs70-shell .j70-btn-primary{background:#0d9488;color:#fff}\n#jobs70-shell .j70-btn-outline{background:#fff;color:#334155;border:1px solid #e2e8f0}\n#jobs70-shell .j70-search-row{display:flex;gap:.75rem;flex-wrap:wrap;margin-bottom:1rem}\n#jobs70-shell .j70-search-wrap{position:relative;flex:1;min-width:240px}\n#jobs70-shell .j70-search-wrap svg{position:absolute;left:.75rem;top:50%;transform:translateY(-50%);width:16px;height:16px;color:#94a3b8}\n#jobs70-shell .j70-input,#jobs70-shell .j70-select{width:100%;padding:.5rem .75rem;border:1px solid #e2e8f0;border-radius:.5rem;font-size:.875rem;outline:none;background:#fff}\n#jobs70-shell .j70-search-wrap .j70-input{padding-left:2.25rem}\n#jobs70-shell .j70-input:focus,#jobs70-shell .j70-select:focus{border-color:#0d9488;box-shadow:0 0 0 2px rgba(13,148,136,.08)}\n#jobs70-shell .j70-tabs{display:flex;gap:0;background:#f1f5f9;border-radius:.5rem;padding:.25rem;margin-bottom:1rem;width:fit-content}\n#jobs70-shell .j70-tab{padding:.5rem 1rem;border:none;border-radius:.375rem;background:transparent;color:#64748b;font-size:.8125rem;font-weight:500;cursor:pointer;white-space:nowrap}\n#jobs70-shell .j70-tab.active{background:#fff;color:#0f172a;box-shadow:0 1px 2px rgba(0,0,0,.05)}\n#jobs70-shell .j70-panel{display:none}\n#jobs70-shell .j70-panel.active{display:block}\n#jobs70-shell .j70-empty{text-align:center;padding:3rem 1rem;color:#94a3b8;font-size:.875rem}\n#jobs70-shell .j70-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:100;align-items:center;justify-content:center}\n#jobs70-shell .j70-overlay.show{display:flex}\n#jobs70-shell .j70-modal{background:#fff;border-radius:.75rem;padding:1.5rem;max-width:32rem;width:90%;max-height:90vh;overflow-y:auto;box-shadow:0 25px 50px -12px rgba(0,0,0,.25)}\n#jobs70-shell .j70-modal h3{margin:0 0 1rem;font-size:1.125rem;font-weight:600;color:#0f172a}\n#jobs70-shell .j70-modal label{display:block;margin:.75rem 0 .25rem;font-size:.8125rem;font-weight:500;color:#334155}\n</style>\n<div id=\"jobs70-shell\">\n  <div class=\"j70-header\">\n    <div>\n      <h1>Jobs Board</h1>\n      <p>Find and post caregiving opportunities</p>\n    </div>\n    <button class=\"j70-btn j70-btn-primary\" type=\"button\" onclick=\"window.__jobs70 && window.__jobs70.openCreate()\">\n      <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"></line><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line></svg>\n      Post Job\n    </button>\n  </div>\n  <div class=\"j70-search-row\">\n    <div class=\"j70-search-wrap\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"11\" cy=\"11\" r=\"8\"></circle><line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"></line></svg>\n      <input class=\"j70-input\" id=\"jobs70-search\" type=\"text\" placeholder=\"Search jobs...\">\n    </div>\n    <div style=\"min-width:160px;flex:0 0 180px\">\n      <select class=\"j70-select\" id=\"jobs70-type-filter\">\n        <option value=\"\">All Sources</option>\n        <option value=\"general\">General</option>\n        <option value=\"group_task\">Group Task</option>\n        <option value=\"cared_one_checkin\">Check-In</option>\n        <option value=\"cared_one_care\">Ongoing Care</option>\n      </select>\n    </div>\n  </div>\n  <div class=\"j70-tabs\">\n    <button class=\"j70-tab active\" data-tab=\"browse\" type=\"button\">Browse Jobs</button>\n    <button class=\"j70-tab\" data-tab=\"applications\" type=\"button\">My Applications</button>\n    <button class=\"j70-tab\" data-tab=\"posted\" type=\"button\">My Posted Jobs</button>\n  </div>\n</div>\n<script>\n(function(){\n  const base='/careconnected/wp-json/wp/v2';\n  const state={uid:null,tab:'browse',search:'',type:'',jobs:[],applications:[],posted:[],listeners:{}};\n  function emit(name){(state.listeners[name]||[]).forEach(fn=>{try{fn(state)}catch(e){}})}\n  function on(name,fn){state.listeners[name]=state.listeners[name]||[];state.listeners[name].push(fn);return()=>state.listeners[name]=(state.listeners[name]||[]).filter(x=>x!==fn)}\n  async function getUid(){if(state.uid)return state.uid;try{const r=await fetch(base+'/users/me',{credentials:'include'});if(!r.ok)return null;state.uid=(await r.json()).id;return state.uid}catch(e){return null}}\n  async function load(){\n    const uid=await getUid();\n    try{const r=await fetch(base+'/care_job?per_page=50&orderby=date&order=desc',{credentials:'include'});state.jobs=r.ok?await r.json():[]}catch(e){state.jobs=[]}\n    if(uid){\n      try{const r=await fetch(base+'/job_application?author='+uid+'&per_page=50&orderby=date&order=desc',{credentials:'include'});state.applications=r.ok?await r.json():[]}catch(e){state.applications=[]}\n      state.posted=state.jobs.filter(j=>j.author===uid)\n    }else{state.applications=[];state.posted=[]}\n    emit('data')\n  }\n  function setTab(tab){state.tab=tab;document.querySelectorAll('#jobs70-shell .j70-tab').forEach(b=>b.classList.toggle('active',b.dataset.tab===tab));document.querySelectorAll('.j70-panel').forEach(p=>p.classList.toggle('active',p.dataset-panel===tab));emit('tab')}\n  function nonce(){return document.querySelector('meta[name=\"wp-nonce\"]')?.content||''}\n  async function createJob(payload){await fetch(base+'/care_job',{method:'POST',credentials:'include',headers:{'Content-Type':'application/json','X-WP-Nonce':nonce()},body:JSON.stringify(payload)});await load()}\n  async function createApplication(payload){await fetch(base+'/job_application',{method:'POST',credentials:'include',headers:{'Content-Type':'application/json','X-WP-Nonce':nonce()},body:JSON.stringify(payload)});await load()}\n  async function updateApplication(id,payload){await fetch(base+'/job_application/'+id,{method:'POST',credentials:'include',headers:{'Content-Type':'application/json','X-WP-Nonce':nonce()},body:JSON.stringify(payload)});await load()}\n  window.__jobs70={state,on,emit,load,setTab,createJob,createApplication,updateApplication,openCreate(){window.dispatchEvent(new CustomEvent('jobs70:create-open'))},openApply(detail){window.dispatchEvent(new CustomEvent('jobs70:apply-open',{detail}))}};\n  document.querySelectorAll('#jobs70-shell .j70-tab').forEach(btn=>btn.addEventListener('click',()=>setTab(btn.dataset.tab)));\n  document.getElementById('jobs70-search').addEventListener('input',e=>{state.search=e.target.value.toLowerCase();emit('filter')});\n  document.getElementById('jobs70-type-filter').addEventListener('change',e=>{state.type=e.target.value;emit('filter')});\n  setTab('browse');\n  load();\n})();\n</script>\n<!-- /wp:html -->\n<!-- wp:html -->\n<style>\n#jobs70-browse{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}\n#jobs70-browse .j70-card{background:#fff;border-radius:.75rem;box-shadow:0 1px 3px rgba(0,0,0,.1);border:1px solid transparent;padding:1.25rem;margin-bottom:1rem}\n#jobs70-browse .j70-card-top{display:flex;align-items:flex-start;justify-content:space-between;gap:.75rem;margin-bottom:.75rem}\n#jobs70-browse .j70-title{margin:0;font-size:1.125rem;font-weight:600;color:#0f172a}\n#jobs70-browse .j70-badges{display:flex;gap:.5rem;flex-wrap:wrap;margin:.25rem 0}\n#jobs70-browse .j70-badge{display:inline-block;padding:.125rem .5rem;border-radius:9999px;font-size:.7rem;font-weight:500}\n#jobs70-browse .j70-badge-type{background:#f1f5f9;color:#475569}\n#jobs70-browse .j70-badge-open{background:#0d9488;color:#fff}\n#jobs70-browse .j70-badge-closed{background:#e2e8f0;color:#64748b}\n#jobs70-browse .j70-badge-applied{background:#dcfce7;color:#166534;border:1px solid #bbf7d0}\n#jobs70-browse .j70-meta{display:flex;flex-wrap:wrap;gap:.75rem;font-size:.8125rem;color:#64748b;margin-bottom:.5rem}\n#jobs70-browse .j70-meta span{display:flex;align-items:center;gap:.25rem}\n#jobs70-browse .j70-meta svg{width:12px;height:12px}\n#jobs70-browse .j70-desc{font-size:.875rem;color:#64748b;margin-bottom:1rem;display:-webkit-box;display:box;line-clamp:3;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}\n#jobs70-browse .j70-footer{display:flex;align-items:center;justify-content:space-between;gap:.75rem;flex-wrap:wrap}\n#jobs70-browse .j70-date{font-size:.75rem;color:#94a3b8}\n#jobs70-browse .j70-btn{display:inline-flex;align-items:center;gap:.375rem;padding:.375rem .75rem;border:none;border-radius:.5rem;font-size:.8125rem;font-weight:500;cursor:pointer}\n#jobs70-browse .j70-btn-primary{background:#0d9488;color:#fff}\n#jobs70-browse .j70-btn-outline{background:#fff;color:#334155;border:1px solid #e2e8f0}\n#jobs70-browse .j70-empty{text-align:center;padding:3rem 1rem;color:#94a3b8;font-size:.875rem}\n</style>\n<div id=\"jobs70-browse\" class=\"j70-panel active\" data-panel=\"browse\">\n  <div class=\"j70-empty\">Loading jobs...</div>\n</div>\n<script>\n(function(){\n  const root=document.getElementById('jobs70-browse');\n  const sourceLabels={general:'General',group_task:'Group Task',cared_one_checkin:'Check-In',cared_one_care:'Ongoing Care'};\n  function fmtDate(d){return new Date(d).toLocaleDateString('en',{month:'short',day:'numeric',year:'numeric'})}\n  function strip(html){return (html||'').replace(/<[^>]*>/g,'')}\n  function render(){\n    const api=window.__jobs70;if(!api)return;\n    const s=api.state;\n    const appliedIds=new Set((s.applications||[]).map(a=>a.meta?.job_id));\n    const postedIds=new Set((s.posted||[]).map(j=>j.id));\n    let jobs=(s.jobs||[]).filter(j=>{\n      const q=s.search||''; const type=s.type||'';\n      const title=(j.title?.rendered||'').toLowerCase();\n      const body=strip(j.content?.rendered||'').toLowerCase();\n      if(q && !title.includes(q) && !body.includes(q)) return false;\n      if(type && (j.meta?.job_source_type||'general')!==type) return false;\n      return true;\n    });\n    if(!jobs.length){root.innerHTML='<div class=\"j70-empty\">No jobs found</div>';return}\n    root.innerHTML=jobs.map(j=>{\n      const id=j.id; const title=j.title?.rendered||'Job'; const desc=strip(j.content?.rendered||'');\n      const status=j.meta?.status||j.status||'open'; const type=j.meta?.job_source_type||'general';\n      const loc=j.meta?.location||''; const poster=j.meta?.poster_name||''; const date=fmtDate(j.date);\n      let action='';\n      if(postedIds.has(id)) action='<button class=\"j70-btn j70-btn-outline\" type=\"button\" onclick=\"window.__jobs70.setTab(\\'posted\\')\">Manage</button>';\n      else if(appliedIds.has(id)) action='<span class=\"j70-badge j70-badge-applied\">Applied ✓</span>';\n      else if(status==='open') action='<button class=\"j70-btn j70-btn-primary\" type=\"button\" onclick=\"window.__jobs70.openApply({jobId:'+id+',title:'+JSON.stringify(title)+'})\">Apply</button>';\n      return '<div class=\"j70-card\"><div class=\"j70-card-top\"><div style=\"flex:1\"><h3 class=\"j70-title\">'+title+'</h3><div class=\"j70-badges\"><span class=\"j70-badge j70-badge-type\">'+(sourceLabels[type]||type)+'</span><span class=\"j70-badge '+(status==='open'?'j70-badge-open':'j70-badge-closed')+'\">'+status+'</span></div><div class=\"j70-meta\">'\n        +(poster?'<span><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2\"></path><circle cx=\"12\" cy=\"7\" r=\"4\"></circle></svg>'+poster+'</span>':'')\n        +(loc?'<span><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>'+loc+'</span>':'')\n        +'</div></div><div class=\"j70-date\">'+date+'</div></div><div class=\"j70-desc\">'+desc+'</div><div class=\"j70-footer\"><div></div><div>'+action+'</div></div></div>';\n    }).join('');\n  }\n  function bind(){const api=window.__jobs70;if(!api)return false;api.on('data',render);api.on('filter',render);api.on('tab',render);render();return true}\n  if(!bind()){const t=setInterval(()=>{if(bind())clearInterval(t)},200)}\n})();\n</script>\n<!-- /wp:html -->\n<!-- wp:html -->\n<style>\n#jobs70-applications{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}\n#jobs70-applications .j70-card{background:#fff;border-radius:.75rem;box-shadow:0 1px 3px rgba(0,0,0,.1);border:1px solid transparent;padding:1.25rem;margin-bottom:1rem}\n#jobs70-applications .j70-top{display:flex;align-items:center;justify-content:space-between;gap:.75rem;margin-bottom:.5rem}\n#jobs70-applications .j70-title{margin:0;font-size:.95rem;font-weight:600;color:#0f172a}\n#jobs70-applications .j70-letter{font-size:.875rem;color:#64748b;display:-webkit-box;display:box;line-clamp:2;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin:.5rem 0}\n#jobs70-applications .j70-badge{display:inline-block;padding:.125rem .5rem;border-radius:9999px;font-size:.7rem;font-weight:500}\n#jobs70-applications .j70-pending{background:#fef3c7;color:#92400e}\n#jobs70-applications .j70-accepted{background:#0d9488;color:#fff}\n#jobs70-applications .j70-rejected{background:#ef4444;color:#fff}\n#jobs70-applications .j70-date{font-size:.75rem;color:#94a3b8}\n#jobs70-applications .j70-empty{text-align:center;padding:3rem 1rem;color:#94a3b8;font-size:.875rem}\n</style>\n<div id=\"jobs70-applications\" class=\"j70-panel\" data-panel=\"applications\">\n  <div class=\"j70-empty\">Loading applications...</div>\n</div>\n<script>\n(function(){\n  const root=document.getElementById('jobs70-applications');\n  function render(){\n    const api=window.__jobs70;if(!api)return; const items=api.state.applications||[];\n    if(!items.length){root.innerHTML='<div class=\"j70-empty\">No applications yet</div>';return}\n    root.innerHTML=items.map(a=>{\n      const title=a.title?.rendered||'Application'; const status=a.meta?.status||'pending'; const letter=a.meta?.cover_letter||'';\n      const badgeClass=status==='accepted'?'j70-accepted':status==='rejected'?'j70-rejected':'j70-pending';\n      const date=new Date(a.date).toLocaleDateString('en',{month:'short',day:'numeric',year:'numeric'});\n      return '<div class=\"j70-card\"><div class=\"j70-top\"><h3 class=\"j70-title\">'+title+'</h3><span class=\"j70-badge '+badgeClass+'\">'+status+'</span></div><div class=\"j70-letter\">'+letter+'</div><div class=\"j70-date\">Applied '+date+'</div></div>';\n    }).join('');\n  }\n  function bind(){const api=window.__jobs70;if(!api)return false;api.on('data',render);api.on('tab',render);render();return true}\n  if(!bind()){const t=setInterval(()=>{if(bind())clearInterval(t)},200)}\n})();\n</script>\n<!-- /wp:html -->\n<!-- wp:html -->\n<style>\n#jobs70-posted{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}\n#jobs70-posted .j70-card{background:#fff;border-radius:.75rem;box-shadow:0 1px 3px rgba(0,0,0,.1);border:1px solid transparent;padding:1.25rem;margin-bottom:1rem}\n#jobs70-posted .j70-title{margin:0 0 .25rem;font-size:1rem;font-weight:600;color:#0f172a}\n#jobs70-posted .j70-badges{display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:.5rem}\n#jobs70-posted .j70-badge{display:inline-block;padding:.125rem .5rem;border-radius:9999px;font-size:.7rem;font-weight:500}\n#jobs70-posted .j70-type{background:#f1f5f9;color:#475569}\n#jobs70-posted .j70-open{background:#0d9488;color:#fff}\n#jobs70-posted .j70-closed{background:#e2e8f0;color:#64748b}\n#jobs70-posted .j70-desc{font-size:.875rem;color:#64748b;display:-webkit-box;display:box;line-clamp:2;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:.75rem}\n#jobs70-posted .j70-toggle{display:inline-flex;align-items:center;gap:.375rem;font-size:.875rem;font-weight:500;color:#0d9488;background:none;border:none;padding:0;cursor:pointer}\n#jobs70-posted .j70-apps{display:none;margin-top:.75rem;padding-top:1rem;border-top:1px solid #e2e8f0}\n#jobs70-posted .j70-apps.show{display:block}\n#jobs70-posted .j70-app-card{border:1px solid #e2e8f0;border-radius:.5rem;padding:1rem;background:#fafafa;margin-top:.75rem}\n#jobs70-posted .j70-app-top{display:flex;align-items:center;justify-content:space-between;gap:.75rem;margin-bottom:.5rem}\n#jobs70-posted .j70-app-name{font-size:.875rem;font-weight:600;color:#0f172a}\n#jobs70-posted .j70-app-letter{font-size:.8125rem;color:#64748b;background:#fff;border-radius:.375rem;padding:.5rem;margin:.5rem 0}\n#jobs70-posted .j70-btn{display:inline-flex;align-items:center;gap:.375rem;padding:.375rem .75rem;border:none;border-radius:.5rem;font-size:.8125rem;font-weight:500;cursor:pointer}\n#jobs70-posted .j70-accept{background:#22c55e;color:#fff}\n#jobs70-posted .j70-decline{background:#fff;color:#ef4444;border:1px solid rgba(239,68,68,.3)}\n#jobs70-posted .j70-empty{text-align:center;padding:3rem 1rem;color:#94a3b8;font-size:.875rem}\n</style>\n<div id=\"jobs70-posted\" class=\"j70-panel\" data-panel=\"posted\">\n  <div class=\"j70-empty\">Loading posted jobs...</div>\n</div>\n<script>\n(function(){\n  const root=document.getElementById('jobs70-posted');\n  const sourceLabels={general:'General',group_task:'Group Task',cared_one_checkin:'Check-In',cared_one_care:'Ongoing Care'};\n  const cache={};\n  async function loadApplicants(jobId,wrap){\n    wrap.innerHTML='<div class=\"j70-empty\" style=\"padding:1rem\">Loading applicants...</div>';\n    try{\n      const r=await fetch('/careconnected/wp-json/wp/v2/job_application?meta_key=job_id&meta_value='+jobId+'&per_page=20',{credentials:'include'});\n      cache[jobId]=r.ok?await r.json():[];\n    }catch(e){cache[jobId]=[]}\n    renderApplicants(jobId,wrap);\n  }\n  function renderApplicants(jobId,wrap){\n    const apps=cache[jobId]||[];\n    if(!apps.length){wrap.innerHTML='<div class=\"j70-empty\" style=\"padding:1rem\">No applications yet</div>';return}\n    wrap.innerHTML=apps.map(a=>{\n      const status=a.meta?.status||'pending';\n      const badge=status==='accepted'?'style=\"background:#0d9488;color:#fff\"':status==='rejected'?'style=\"background:#ef4444;color:#fff\"':'style=\"background:#fef3c7;color:#92400e\"';\n      const actions=status==='pending'?'<div style=\"display:flex;gap:.5rem;margin-top:.5rem\"><button class=\"j70-btn j70-accept\" type=\"button\" onclick=\"window.__jobs70.updateApplication('+a.id+',{meta:{status:\\'accepted\\'}})\">Accept</button><button class=\"j70-btn j70-decline\" type=\"button\" onclick=\"window.__jobs70.updateApplication('+a.id+',{meta:{status:\\'rejected\\'}})\">Decline</button></div>':'';\n      return '<div class=\"j70-app-card\"><div class=\"j70-app-top\"><div class=\"j70-app-name\">'+(a.title?.rendered||'Applicant')+'</div><span class=\"j70-badge\" '+badge+'>'+status+'</span></div><div class=\"j70-app-letter\">'+(a.meta?.cover_letter||'')+'</div>'+actions+'</div>';\n    }).join('');\n  }\n  function render(){\n    const api=window.__jobs70;if(!api)return; const items=api.state.posted||[];\n    if(!items.length){root.innerHTML='<div class=\"j70-empty\">You haven\\'t posted any jobs yet</div>';return}\n    root.innerHTML=items.map(j=>{\n      const type=j.meta?.job_source_type||'general'; const status=j.meta?.status||j.status||'open';\n      return '<div class=\"j70-card\"><h3 class=\"j70-title\">'+(j.title?.rendered||'Job')+'</h3><div class=\"j70-badges\"><span class=\"j70-badge j70-type\">'+(sourceLabels[type]||type)+'</span><span class=\"j70-badge '+(status==='open'?'j70-open':'j70-closed')+'\">'+status+'</span></div><div class=\"j70-desc\">'+((j.content?.rendered||'').replace(/<[^>]*>/g,''))+'</div><button class=\"j70-toggle\" type=\"button\" data-job=\"'+j.id+'\">View Applicants</button><div class=\"j70-apps\" id=\"jobs70-apps-'+j.id+'\"></div></div>';\n    }).join('');\n    root.querySelectorAll('.j70-toggle').forEach(btn=>btn.addEventListener('click',()=>{\n      const jobId=btn.dataset.job; const wrap=document.getElementById('jobs70-apps-'+jobId); const show=!wrap.classList.contains('show');\n      wrap.classList.toggle('show',show); btn.textContent=show?'Hide Applicants':'View Applicants';\n      if(show && !cache[jobId]) loadApplicants(jobId,wrap);\n    }));\n  }\n  function bind(){const api=window.__jobs70;if(!api)return false;api.on('data',render);api.on('tab',render);render();return true}\n  if(!bind()){const t=setInterval(()=>{if(bind())clearInterval(t)},200)}\n})();\n</script>\n<!-- /wp:html -->\n<!-- wp:html -->\n<style>\n#jobs70-modals{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}\n#jobs70-modals .j70-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:100;align-items:center;justify-content:center}\n#jobs70-modals .j70-overlay.show{display:flex}\n#jobs70-modals .j70-modal{background:#fff;border-radius:.75rem;padding:1.5rem;max-width:32rem;width:90%;max-height:90vh;overflow-y:auto;box-shadow:0 25px 50px -12px rgba(0,0,0,.25)}\n#jobs70-modals .j70-modal h3{margin:0 0 1rem;font-size:1.125rem;font-weight:600;color:#0f172a}\n#jobs70-modals .j70-label{display:block;margin:.75rem 0 .25rem;font-size:.8125rem;font-weight:500;color:#334155}\n#jobs70-modals .j70-input,#jobs70-modals .j70-textarea,#jobs70-modals .j70-select{width:100%;padding:.5rem .75rem;border:1px solid #e2e8f0;border-radius:.5rem;font-size:.875rem;outline:none;background:#fff;font-family:inherit}\n#jobs70-modals .j70-textarea{resize:vertical}\n#jobs70-modals .j70-input:focus,#jobs70-modals .j70-textarea:focus,#jobs70-modals .j70-select:focus{border-color:#0d9488;box-shadow:0 0 0 2px rgba(13,148,136,.08)}\n#jobs70-modals .j70-actions{display:flex;gap:.5rem;justify-content:flex-end;margin-top:1.25rem}\n#jobs70-modals .j70-btn{display:inline-flex;align-items:center;gap:.375rem;padding:.5rem 1rem;border:none;border-radius:.5rem;font-size:.875rem;font-weight:500;cursor:pointer}\n#jobs70-modals .j70-btn-primary{background:#0d9488;color:#fff}\n#jobs70-modals .j70-btn-outline{background:#fff;color:#334155;border:1px solid #e2e8f0}\n</style>\n<div id=\"jobs70-modals\">\n  <div class=\"j70-overlay\" id=\"jobs70-create-overlay\">\n    <div class=\"j70-modal\">\n      <h3>Post a Care Job</h3>\n      <label class=\"j70-label\" for=\"jobs70-create-title\">Job Title *</label>\n      <input class=\"j70-input\" id=\"jobs70-create-title\" type=\"text\" placeholder=\"e.g. Part-time caregiver needed\">\n      <label class=\"j70-label\" for=\"jobs70-create-desc\">Description *</label>\n      <textarea class=\"j70-textarea\" id=\"jobs70-create-desc\" rows=\"5\" placeholder=\"Describe the care needs, schedule, requirements...\"></textarea>\n      <label class=\"j70-label\" for=\"jobs70-create-location\">Location</label>\n      <input class=\"j70-input\" id=\"jobs70-create-location\" type=\"text\" placeholder=\"e.g. Brooklyn, NY\">\n      <label class=\"j70-label\" for=\"jobs70-create-type\">Job Type</label>\n      <select class=\"j70-select\" id=\"jobs70-create-type\">\n        <option value=\"general\">General</option>\n        <option value=\"cared_one_checkin\">Check-In Care</option>\n        <option value=\"cared_one_care\">Ongoing Care</option>\n      </select>\n      <div class=\"j70-actions\">\n        <button class=\"j70-btn j70-btn-outline\" type=\"button\" id=\"jobs70-create-cancel\">Cancel</button>\n        <button class=\"j70-btn j70-btn-primary\" type=\"button\" id=\"jobs70-create-submit\">Post Job</button>\n      </div>\n    </div>\n  </div>\n  <div class=\"j70-overlay\" id=\"jobs70-apply-overlay\">\n    <div class=\"j70-modal\">\n      <h3 id=\"jobs70-apply-title\">Apply to Job</h3>\n      <label class=\"j70-label\" for=\"jobs70-apply-letter\">Cover Letter *</label>\n      <textarea class=\"j70-textarea\" id=\"jobs70-apply-letter\" rows=\"5\" placeholder=\"Introduce yourself and explain why you're a good fit...\"></textarea>\n      <div class=\"j70-actions\">\n        <button class=\"j70-btn j70-btn-outline\" type=\"button\" id=\"jobs70-apply-cancel\">Cancel</button>\n        <button class=\"j70-btn j70-btn-primary\" type=\"button\" id=\"jobs70-apply-submit\">Submit Application</button>\n      </div>\n    </div>\n  </div>\n</div>\n<script>\n(function(){\n  let applyJobId=null;\n  const createOverlay=document.getElementById('jobs70-create-overlay');\n  const applyOverlay=document.getElementById('jobs70-apply-overlay');\n  function open(el){el.classList.add('show')}\n  function close(el){el.classList.remove('show')}\n  function bind(){const api=window.__jobs70;if(!api)return false;\n    window.addEventListener('jobs70:create-open',()=>open(createOverlay));\n    window.addEventListener('jobs70:apply-open',e=>{applyJobId=e.detail?.jobId||null;document.getElementById('jobs70-apply-title').textContent='Apply to: '+(e.detail?.title||'Job');document.getElementById('jobs70-apply-letter').value='';open(applyOverlay)});\n    document.getElementById('jobs70-create-cancel').addEventListener('click',()=>close(createOverlay));\n    document.getElementById('jobs70-apply-cancel').addEventListener('click',()=>close(applyOverlay));\n    createOverlay.addEventListener('click',e=>{if(e.target===createOverlay)close(createOverlay)});\n    applyOverlay.addEventListener('click',e=>{if(e.target===applyOverlay)close(applyOverlay)});\n    document.getElementById('jobs70-create-submit').addEventListener('click',async()=>{\n      const btn=document.getElementById('jobs70-create-submit');\n      const title=document.getElementById('jobs70-create-title').value.trim();\n      const content=document.getElementById('jobs70-create-desc').value.trim();\n      const location=document.getElementById('jobs70-create-location').value.trim();\n      const type=document.getElementById('jobs70-create-type').value;\n      if(!title||!content)return;\n      btn.textContent='Posting...';\n      try{await api.createJob({title,content,status:'publish',meta:{location,job_source_type:type,status:'open'}});close(createOverlay);document.getElementById('jobs70-create-title').value='';document.getElementById('jobs70-create-desc').value='';document.getElementById('jobs70-create-location').value='';document.getElementById('jobs70-create-type').value='general'}catch(e){alert('Failed to post job')}finally{btn.textContent='Post Job'}\n    });\n    document.getElementById('jobs70-apply-submit').addEventListener('click',async()=>{\n      const btn=document.getElementById('jobs70-apply-submit');\n      const letter=document.getElementById('jobs70-apply-letter').value.trim();\n      if(!letter||!applyJobId)return;\n      btn.textContent='Submitting...';\n      try{await api.createApplication({title:'Application',status:'publish',meta:{job_id:applyJobId,cover_letter:letter,status:'pending'}});close(applyOverlay)}catch(e){alert('Failed to submit application')}finally{btn.textContent='Submit Application'}\n    });\n    return true;\n  }\n  if(!bind()){const t=setInterval(()=>{if(bind())clearInterval(t)},200)}\n})();\n</script>\n<!-- /wp:html -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->", "status": "publish"}