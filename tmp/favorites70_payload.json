{"content": "<!-- wp:columns {\"isStackedOnMobile\":false} -->\n<div class=\"wp-block-columns is-not-stacked-on-mobile\"><!-- wp:column {\"width\":\"220px\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:220px\"><!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"1rem\",\"right\":\"0.75rem\",\"bottom\":\"1rem\",\"left\":\"0.75rem\"}},\"border\":{\"right\":{\"color\":\"#e5e7eb\",\"width\":\"1px\"}}},\"backgroundColor\":\"base\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group has-base-background-color has-background\" style=\"border-right-color:#e5e7eb;border-right-width:1px;padding-top:1rem;padding-right:0.75rem;padding-bottom:1rem;padding-left:0.75rem\"><!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/dashboard/\">🏠 Dashboard</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/favorites/\">⭐ Favorites</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column -->\n<!-- wp:column {\"style\":{\"color\":{\"background\":\"#f9fafb\"}}} -->\n<div class=\"wp-block-column has-background\" style=\"background-color:#f9fafb\">\n<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"right\":\"1.5rem\",\"left\":\"1.5rem\",\"bottom\":\"1.5rem\"}}}} -->\n<div class=\"wp-block-group\" style=\"padding-right:1.5rem;padding-left:1.5rem;padding-bottom:1.5rem\">\n<!-- wp:html -->\n<style>\n#fav70-shell{max-width:48rem;margin:0 auto;padding:1.5rem 1rem;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}\n#fav70-shell *{box-sizing:border-box}\n#fav70-shell .f70-header{margin-bottom:1.5rem}\n#fav70-shell .f70-header h1{font-size:1.5rem;font-weight:700;color:#0f172a;margin:0}\n#fav70-shell .f70-header p{margin:.25rem 0 0;font-size:.875rem;color:#64748b}\n</style>\n<div id=\"fav70-shell\">\n  <div class=\"f70-header\">\n    <h1>Saved Providers</h1>\n    <p>Your favorite care providers</p>\n  </div>\n</div>\n<script>\n(function(){\n  const base='/careconnected/wp-json/wp/v2';\n  const state={items:[],listeners:{}};\n  function emit(name){(state.listeners[name]||[]).forEach(fn=>{try{fn(state)}catch(e){}})}\n  function on(name,fn){state.listeners[name]=state.listeners[name]||[];state.listeners[name].push(fn);return()=>state.listeners[name]=(state.listeners[name]||[]).filter(x=>x!==fn)}\n  function nonce(){return document.querySelector('meta[name=\"wp-nonce\"]')?.content||''}\n  async function load(){try{const r=await fetch(base+'/saved_provider?per_page=50',{credentials:'include'});state.items=r.ok?await r.json():[]}catch(e){state.items=[]}emit('data')}\n  async function remove(id){await fetch(base+'/saved_provider/'+id+'?force=true',{method:'DELETE',credentials:'include',headers:{'X-WP-Nonce':nonce()}});await load()}\n  window.__fav70={state,on,emit,load,remove};\n  load();\n})();\n</script>\n<!-- /wp:html -->\n<!-- wp:html -->\n<style>\n#fav70-list{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}\n#fav70-list .f70-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1rem}\n#fav70-list .f70-card{background:#fff;border-radius:.75rem;box-shadow:0 1px 3px rgba(0,0,0,.1);border:1px solid transparent;padding:1.25rem}\n#fav70-list .f70-top{display:flex;align-items:center;gap:.75rem;margin-bottom:.75rem}\n#fav70-list .f70-avatar{width:48px;height:48px;border-radius:.75rem;background:rgba(13,148,136,.1);display:flex;align-items:center;justify-content:center;font-weight:600;color:#0d9488;font-size:1rem;flex-shrink:0}\n#fav70-list .f70-name{font-weight:600;font-size:.9375rem;color:#0f172a}\n#fav70-list .f70-specialty{font-size:.8125rem;color:#64748b}\n#fav70-list .f70-rating{display:flex;align-items:center;gap:.25rem;font-size:.8125rem;color:#f59e0b;margin-top:.25rem}\n#fav70-list .f70-rating svg{width:14px;height:14px;fill:#f59e0b}\n#fav70-list .f70-meta{display:flex;flex-wrap:wrap;gap:.5rem;font-size:.75rem;color:#64748b;margin-bottom:.75rem}\n#fav70-list .f70-actions{display:flex;gap:.5rem}\n#fav70-list .f70-btn{display:inline-flex;align-items:center;justify-content:center;gap:.375rem;padding:.375rem .75rem;border:none;border-radius:.5rem;font-size:.8125rem;font-weight:500;cursor:pointer;text-decoration:none}\n#fav70-list .f70-primary{background:#0d9488;color:#fff;flex:1}\n#fav70-list .f70-ghost{background:transparent;color:#ef4444}\n#fav70-list .f70-empty{text-align:center;padding:3rem 1rem;color:#94a3b8;font-size:.875rem}\n</style>\n<div id=\"fav70-list\">\n  <div class=\"f70-empty\">Loading saved providers...</div>\n</div>\n<script>\n(function(){\n  const root=document.getElementById('fav70-list');\n  function render(){\n    const api=window.__fav70;if(!api)return; const items=api.state.items||[];\n    if(!items.length){root.innerHTML='<div class=\"f70-empty\">No saved providers yet</div>';return}\n    root.innerHTML='<div class=\"f70-grid\">'+items.map(p=>{\n      const name=p.title?.rendered||'Provider'; const init=name.charAt(0).toUpperCase(); const specialty=p.meta?.specialty||'Care Provider';\n      const rating=p.meta?.rating||''; const location=p.meta?.location||''; const rate=p.meta?.hourly_rate||'';\n      return '<div class=\"f70-card\"><div class=\"f70-top\"><div class=\"f70-avatar\">'+init+'</div><div><div class=\"f70-name\">'+name+'</div><div class=\"f70-specialty\">'+specialty+'</div>'+(rating?'<div class=\"f70-rating\"><svg viewBox=\"0 0 24 24\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg>'+rating+'</div>':'')+'</div></div><div class=\"f70-meta\">'+(location?'<span>'+location+'</span>':'')+(rate?'<span>$'+rate+'/hr</span>':'')+'</div><div class=\"f70-actions\"><a class=\"f70-btn f70-primary\" href=\"/careconnected/store-listing/\">Book</a><button class=\"f70-btn f70-ghost\" type=\"button\" onclick=\"window.__fav70.remove('+p.id+')\">Remove</button></div></div>';\n    }).join('')+'</div>';\n  }\n  function bind(){const api=window.__fav70;if(!api)return false;api.on('data',render);render();return true}\n  if(!bind()){const t=setInterval(()=>{if(bind())clearInterval(t)},200)}\n})();\n</script>\n<!-- /wp:html -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->", "status": "publish"}