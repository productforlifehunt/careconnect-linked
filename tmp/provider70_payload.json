{"content": "<!-- wp:columns {\"isStackedOnMobile\":false} -->\n<div class=\"wp-block-columns is-not-stacked-on-mobile\"><!-- wp:column {\"width\":\"220px\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:220px\"><!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"1rem\",\"right\":\"0.75rem\",\"bottom\":\"1rem\",\"left\":\"0.75rem\"}},\"border\":{\"right\":{\"color\":\"#e5e7eb\",\"width\":\"1px\"}}},\"backgroundColor\":\"base\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group has-base-background-color has-background\" style=\"border-right-color:#e5e7eb;border-right-width:1px;padding-top:1rem;padding-right:0.75rem;padding-bottom:1rem;padding-left:0.75rem\"><!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/dashboard/\">🏠 Dashboard</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/provider-dashboard/\">⚙️ Provider Hub</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column -->\n<!-- wp:column {\"style\":{\"color\":{\"background\":\"#f9fafb\"}}} -->\n<div class=\"wp-block-column has-background\" style=\"background-color:#f9fafb\">\n<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"right\":\"1.5rem\",\"left\":\"1.5rem\",\"bottom\":\"1.5rem\"}}}} -->\n<div class=\"wp-block-group\" style=\"padding-right:1.5rem;padding-left:1.5rem;padding-bottom:1.5rem\">\n<!-- wp:html -->\n<style>\n#provider70-shell{max-width:64rem;margin:0 auto;padding:1.5rem 1rem;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}\n#provider70-shell *{box-sizing:border-box}\n#provider70-shell .pv70-header{margin-bottom:1.5rem}\n#provider70-shell .pv70-header h1{font-size:1.5rem;font-weight:700;color:#0f172a;margin:0}\n#provider70-shell .pv70-header p{margin:.25rem 0 0;font-size:.875rem;color:#64748b}\n#provider70-shell .pv70-tabs{display:flex;gap:0;background:#f1f5f9;border-radius:.5rem;padding:.25rem;margin-bottom:1.5rem;width:fit-content}\n#provider70-shell .pv70-tab{padding:.5rem 1rem;border:none;border-radius:.375rem;background:transparent;color:#64748b;font-size:.8125rem;font-weight:500;cursor:pointer;white-space:nowrap}\n#provider70-shell .pv70-tab.active{background:#fff;color:#0f172a;box-shadow:0 1px 2px rgba(0,0,0,.05)}\n.pv70-panel{display:none}\n.pv70-panel.active{display:block}\n</style>\n<div id=\"provider70-shell\">\n  <div class=\"pv70-header\">\n    <h1>Provider Dashboard</h1>\n    <p>Manage your care services</p>\n  </div>\n  <div class=\"pv70-tabs\">\n    <button class=\"pv70-tab active\" data-tab=\"requests\" type=\"button\">Booking Requests</button>\n    <button class=\"pv70-tab\" data-tab=\"schedule\" type=\"button\">Schedule</button>\n    <button class=\"pv70-tab\" data-tab=\"earnings\" type=\"button\">Earnings</button>\n  </div>\n</div>\n<script>\n(function(){\n  const base='/careconnected/wp-json/wp/v2';\n  const state={tab:'requests',bookings:[],listeners:{}};\n  function emit(name){(state.listeners[name]||[]).forEach(fn=>{try{fn(state)}catch(e){}})}\n  function on(name,fn){state.listeners[name]=state.listeners[name]||[];state.listeners[name].push(fn);return()=>state.listeners[name]=(state.listeners[name]||[]).filter(x=>x!==fn)}\n  function setTab(tab){state.tab=tab;document.querySelectorAll('#provider70-shell .pv70-tab').forEach(b=>b.classList.toggle('active',b.dataset.tab===tab));document.querySelectorAll('.pv70-panel').forEach(p=>p.classList.toggle('active',p.dataset-panel===tab));emit('tab')}\n  function nonce(){return document.querySelector('meta[name=\"wp-nonce\"]')?.content||''}\n  async function load(){try{const r=await fetch(base+'/wc_booking?per_page=20&orderby=date&order=desc',{credentials:'include'});state.bookings=r.ok?await r.json():[]}catch(e){state.bookings=[]}emit('data')}\n  async function updateBooking(id,payload){await fetch(base+'/wc_booking/'+id,{method:'POST',credentials:'include',headers:{'Content-Type':'application/json','X-WP-Nonce':nonce()},body:JSON.stringify(payload)});await load()}\n  window.__provider70={state,on,emit,setTab,load,updateBooking};\n  document.querySelectorAll('#provider70-shell .pv70-tab').forEach(btn=>btn.addEventListener('click',()=>setTab(btn.dataset.tab)));\n  setTab('requests');\n  load();\n})();\n</script>\n<!-- /wp:html -->\n<!-- wp:html -->\n<style>\n#provider70-requests{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}\n#provider70-requests .pv70-card{background:#fff;border-radius:.75rem;box-shadow:0 1px 3px rgba(0,0,0,.1);border:1px solid #e2e8f0;padding:1rem;margin-bottom:.75rem;background:#fafafa}\n#provider70-requests .pv70-top{display:flex;align-items:center;justify-content:space-between;gap:.75rem;margin-bottom:.5rem}\n#provider70-requests .pv70-info{display:flex;align-items:center;gap:.75rem}\n#provider70-requests .pv70-avatar{width:40px;height:40px;border-radius:.75rem;background:rgba(13,148,136,.1);display:flex;align-items:center;justify-content:center;color:#0d9488;font-weight:500;flex-shrink:0}\n#provider70-requests .pv70-name{font-weight:500;font-size:.9375rem;color:#0f172a}\n#provider70-requests .pv70-service{font-size:.8125rem;color:#64748b}\n#provider70-requests .pv70-meta{display:grid;grid-template-columns:1fr 1fr 1fr;gap:.5rem;font-size:.8125rem;color:#64748b;margin:.5rem 0}\n#provider70-requests .pv70-badge{display:inline-block;padding:.125rem .5rem;border-radius:9999px;font-size:.7rem;font-weight:500}\n#provider70-requests .pv70-pending{background:#fef3c7;color:#92400e}\n#provider70-requests .pv70-confirmed{background:#dcfce7;color:#166534}\n#provider70-requests .pv70-completed{background:#f1f5f9;color:#64748b}\n#provider70-requests .pv70-actions{display:flex;gap:.5rem}\n#provider70-requests .pv70-btn{display:inline-flex;align-items:center;gap:.375rem;padding:.375rem .75rem;border:none;border-radius:.5rem;font-size:.8125rem;font-weight:500;cursor:pointer}\n#provider70-requests .pv70-accept{background:#22c55e;color:#fff}\n#provider70-requests .pv70-decline{background:#fff;color:#ef4444;border:1px solid rgba(239,68,68,.3)}\n#provider70-requests .pv70-empty{text-align:center;padding:3rem 1rem;color:#94a3b8;font-size:.875rem}\n</style>\n<div id=\"provider70-requests\" class=\"pv70-panel active\" data-panel=\"requests\">\n  <div class=\"pv70-empty\">Loading booking requests...</div>\n</div>\n<script>\n(function(){\n  const root=document.getElementById('provider70-requests');\n  function fmtDate(d){return new Date(d).toLocaleDateString('en',{month:'short',day:'numeric',year:'numeric'})}\n  function render(){\n    const api=window.__provider70;if(!api)return; const items=api.state.bookings||[];\n    if(!items.length){root.innerHTML='<div class=\"pv70-empty\">No booking requests at the moment</div>';return}\n    root.innerHTML=items.map(b=>{const name=b.title?.rendered||'Client'; const init=name.charAt(0).toUpperCase(); const status=b.status||'pending'; const service=b.meta?.service_type||'Care'; const cost=b.meta?._booking_cost||'0'; const badge=status==='confirmed'?'pv70-confirmed':status==='completed'?'pv70-completed':'pv70-pending'; const actions=status==='pending'?'<div class=\"pv70-actions\"><button class=\"pv70-btn pv70-accept\" type=\"button\" onclick=\"window.__provider70.updateBooking('+b.id+',{status:\\'confirmed\\'})\">Accept</button><button class=\"pv70-btn pv70-decline\" type=\"button\" onclick=\"window.__provider70.updateBooking('+b.id+',{status:\\'cancelled\\'})\">Decline</button></div>':''; return '<div class=\"pv70-card\"><div class=\"pv70-top\"><div class=\"pv70-info\"><div class=\"pv70-avatar\">'+init+'</div><div><div class=\"pv70-name\">'+name+'</div><div class=\"pv70-service\">'+service+'</div></div></div><span class=\"pv70-badge '+badge+'\">'+status+'</span></div><div class=\"pv70-meta\"><span>'+fmtDate(b.date)+'</span><span>'+(b.meta?._booking_start||'')+'</span><span style=\"font-weight:600;color:#0f172a\">$'+cost+'</span></div>'+actions+'</div>'}).join('');\n  }\n  function bind(){const api=window.__provider70;if(!api)return false;api.on('data',render);api.on('tab',render);render();return true}\n  if(!bind()){const t=setInterval(()=>{if(bind())clearInterval(t)},200)}\n})();\n</script>\n<!-- /wp:html -->\n<!-- wp:html -->\n<style>\n#provider70-schedule{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}\n#provider70-schedule .pv70-card{background:#fff;border-radius:.75rem;box-shadow:0 1px 3px rgba(0,0,0,.1);border:1px solid transparent;margin-bottom:1rem}\n#provider70-schedule .pv70-hdr{padding:1.25rem 1.5rem 0;font-weight:600;font-size:1rem;color:#0f172a}\n#provider70-schedule .pv70-body{padding:1.25rem 1.5rem}\n#provider70-schedule .pv70-grid{display:grid;gap:.5rem}\n#provider70-schedule .pv70-day{display:flex;align-items:center;justify-content:space-between;padding:.75rem;border:1px solid #e2e8f0;border-radius:.5rem;gap:1rem;flex-wrap:wrap}\n#provider70-schedule .pv70-day-name{font-weight:500;font-size:.875rem;color:#0f172a;width:100px}\n#provider70-schedule .pv70-times{display:flex;gap:.5rem;align-items:center}\n#provider70-schedule .pv70-input{padding:.375rem;border:1px solid #e2e8f0;border-radius:.375rem;font-size:.8125rem;width:90px}\n#provider70-schedule .pv70-switch{width:44px;height:24px;border-radius:12px;background:#e2e8f0;position:relative;cursor:pointer;border:none;transition:background .2s;flex-shrink:0}\n#provider70-schedule .pv70-switch.on{background:#0d9488}\n#provider70-schedule .pv70-switch::after{content:'';position:absolute;top:2px;left:2px;width:20px;height:20px;border-radius:50%;background:#fff;transition:transform .2s;box-shadow:0 1px 2px rgba(0,0,0,.1)}\n#provider70-schedule .pv70-switch.on::after{transform:translateX(20px)}\n#provider70-schedule .pv70-btn{display:inline-flex;align-items:center;gap:.5rem;padding:.5rem 1rem;border:none;border-radius:.5rem;font-size:.875rem;font-weight:500;cursor:pointer;background:#0d9488;color:#fff}\n</style>\n<div id=\"provider70-schedule\" class=\"pv70-panel\" data-panel=\"schedule\">\n  <div class=\"pv70-card\"><div class=\"pv70-hdr\">Weekly Availability</div><div class=\"pv70-body\"><div class=\"pv70-grid\" id=\"pv70-schedule-grid\"></div><div style=\"margin-top:1rem\"><button class=\"pv70-btn\" type=\"button\" id=\"pv70-save-schedule\">Save Schedule</button></div></div></div>\n</div>\n<script>\n(function(){\n  const root=document.getElementById('provider70-schedule');\n  const days=['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'];\n  const grid=document.getElementById('pv70-schedule-grid');\n  grid.innerHTML=days.map(d=>'<div class=\"pv70-day\"><span class=\"pv70-day-name\">'+d+'</span><div class=\"pv70-times\"><input class=\"pv70-input\" type=\"time\" value=\"09:00\"><span style=\"color:#94a3b8\">to</span><input class=\"pv70-input\" type=\"time\" value=\"17:00\"></div><button class=\"pv70-switch on\" type=\"button\"></button></div>').join('');\n  root.querySelectorAll('.pv70-switch').forEach(btn=>btn.addEventListener('click',()=>btn.classList.toggle('on')));\n  document.getElementById('pv70-save-schedule').addEventListener('click',()=>alert('Schedule saved!'));\n})();\n</script>\n<!-- /wp:html -->\n<!-- wp:html -->\n<style>\n#provider70-earnings{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}\n#provider70-earnings .pv70-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-bottom:1.5rem}\n#provider70-earnings .pv70-stat{background:#fff;border-radius:.75rem;box-shadow:0 1px 3px rgba(0,0,0,.1);border:1px solid transparent;padding:1rem;text-align:center}\n#provider70-earnings .pv70-value{font-size:1.5rem;font-weight:700;color:#0f172a}\n#provider70-earnings .pv70-label{font-size:.75rem;color:#64748b;margin-top:.25rem}\n#provider70-earnings .pv70-card{background:#fff;border-radius:.75rem;box-shadow:0 1px 3px rgba(0,0,0,.1);border:1px solid transparent}\n#provider70-earnings .pv70-hdr{padding:1.25rem 1.5rem 0;font-weight:600;font-size:1rem;color:#0f172a}\n#provider70-earnings .pv70-body{padding:1.25rem 1.5rem}\n#provider70-earnings .pv70-tx{display:flex;align-items:center;justify-content:space-between;padding:.75rem 0;border-bottom:1px solid #f1f5f9;font-size:.875rem}\n#provider70-earnings .pv70-tx:last-child{border-bottom:none}\n#provider70-earnings .pv70-amount{font-weight:600;color:#0f172a}\n#provider70-earnings .pv70-date{font-size:.75rem;color:#94a3b8}\n#provider70-earnings .pv70-empty{text-align:center;padding:1rem;color:#94a3b8;font-size:.875rem}\n</style>\n<div id=\"provider70-earnings\" class=\"pv70-panel\" data-panel=\"earnings\">\n  <div class=\"pv70-stats\"><div class=\"pv70-stat\"><div class=\"pv70-value\">$0</div><div class=\"pv70-label\">Total Earned</div></div><div class=\"pv70-stat\"><div class=\"pv70-value\">$0</div><div class=\"pv70-label\">This Month</div></div><div class=\"pv70-stat\"><div class=\"pv70-value\">0</div><div class=\"pv70-label\">Completed Jobs</div></div></div>\n  <div class=\"pv70-card\"><div class=\"pv70-hdr\">Recent Transactions</div><div class=\"pv70-body\"><div class=\"pv70-empty\">No transactions yet</div></div></div>\n</div>\n<!-- /wp:html -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->", "status": "publish"}