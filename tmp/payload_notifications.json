{"content": "<!-- wp:columns {\"isStackedOnMobile\":false} -->\n<div class=\"wp-block-columns is-not-stacked-on-mobile\"><!-- wp:column {\"width\":\"220px\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:220px\"><!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"1rem\",\"right\":\"0.75rem\",\"bottom\":\"1rem\",\"left\":\"0.75rem\"}},\"border\":{\"right\":{\"color\":\"#e5e7eb\",\"width\":\"1px\"}}},\"backgroundColor\":\"base\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group has-base-background-color has-background\" style=\"border-right-color:#e5e7eb;border-right-width:1px;padding-top:1rem;padding-right:0.75rem;padding-bottom:1rem;padding-left:0.75rem\"><!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/dashboard/\">🏠 Dashboard</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/cared-ones/\">❤️ Loved Ones</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/bookings/\">📅 Appointments</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/inbox/\">💬 Messages</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/care-circle/\">👥 Care Teams</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/jobs/\">💼 Jobs Board</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/store-listing/\">🔍 Find Help</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/gps-tracking/\">📍 GPS Tracking</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/favorites/\">⭐ Favorites</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/community/\">🗣 Community</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/articles/\">📰 Articles</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/provider-dashboard/\">⚙️ Provider Hub</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/notifications/\">🔔 Notifications</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/profile/\">👤 My Profile</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"style\":{\"color\":{\"background\":\"#f9fafb\"}}} -->\n<div class=\"wp-block-column has-background\" style=\"background-color:#f9fafb\"><!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"1.5rem\",\"right\":\"1.5rem\",\"left\":\"1.5rem\"}}},\"layout\":{\"type\":\"flex\",\"flexWrap\":\"nowrap\",\"justifyContent\":\"space-between\"}} -->\n<div class=\"wp-block-group\" style=\"padding-top:1.5rem;padding-right:1.5rem;padding-left:1.5rem\"><!-- wp:heading {\"level\":1,\"style\":{\"typography\":{\"fontSize\":\"clamp(0.984rem, 0.984rem + ((1vw - 0.2rem) * 0.809), 1.5rem)\",\"fontWeight\":\"700\"},\"spacing\":{\"margin\":{\"top\":\"0\",\"bottom\":\"0.25rem\"}}}} -->\n<h1 class=\"wp-block-heading\" style=\"margin-top:0;margin-bottom:0.25rem;font-size:clamp(0.984rem, 0.984rem + ((1vw - 0.2rem) * 0.809), 1.5rem);font-weight:700\">Notifications</h1>\n<!-- /wp:heading --></div>\n<!-- /wp:group -->\n\n<!-- wp:paragraph {\"style\":{\"color\":{\"text\":\"#6b7280\"},\"typography\":{\"fontSize\":\"0.875rem\"},\"spacing\":{\"padding\":{\"left\":\"1.5rem\"}}}} -->\n<p class=\"has-text-color\" style=\"color:#6b7280;font-size:0.875rem;padding-left:1.5rem\">Stay updated on your care activities.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:spacer {\"height\":\"1rem\"} -->\n<div style=\"height:1rem\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"right\":\"1.5rem\",\"left\":\"1.5rem\",\"bottom\":\"1.5rem\"}}},\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group\" style=\"padding-right:1.5rem;padding-left:1.5rem;padding-bottom:1.5rem\"><!-- wp:html -->\n<div id=\"notifications-app\">\n  <div style=\"border-bottom:1px solid #e5e7eb; margin-bottom:1.5rem;\">\n    <div style=\"display:flex; gap:0.5rem;\">\n      <button class=\"notif-tab active\" data-tab=\"all\" style=\"padding:0.75rem 1.5rem; border:none; background:none; cursor:pointer; font-weight:500; color:#0d9488; border-bottom:2px solid #0d9488;\">All</button>\n      <button class=\"notif-tab\" data-tab=\"invitations\" style=\"padding:0.75rem 1.5rem; border:none; background:none; cursor:pointer; font-weight:500; color:#6b7280; border-bottom:2px solid transparent;\">Invitations</button>\n    </div>\n  </div>\n\n  <div id=\"notif-all\" class=\"notif-panel\">\n    <div style=\"display:flex; justify-content:flex-end; margin-bottom:1rem;\">\n      <button id=\"mark-all-read\" style=\"padding:0.4rem 0.75rem; background:white; color:#0d9488; border:1px solid #0d9488; border-radius:6px; font-size:0.8rem; cursor:pointer;\">Mark All Read</button>\n    </div>\n    <div id=\"notif-list\" style=\"min-height:200px;\">\n      <div style=\"text-align:center; padding:3rem; color:#9ca3af;\">⏳ Loading...</div>\n    </div>\n  </div>\n\n  <div id=\"notif-invitations\" class=\"notif-panel\" style=\"display:none;\">\n    <div id=\"invite-list\" style=\"min-height:200px;\">\n      <div style=\"text-align:center; padding:3rem; color:#9ca3af;\">⏳ Loading...</div>\n    </div>\n  </div>\n</div>\n\n<script>\n(function() {\n  const baseUrl = '/careconnected/wp-json/wp/v2';\n  let currentUserId = null;\n\n  async function getUser() {\n    if (currentUserId) return currentUserId;\n    try { const r = await fetch(baseUrl+'/users/me',{credentials:'include'}); if(!r.ok) return null; currentUserId=(await r.json()).id; return currentUserId; } catch(e) { return null; }\n  }\n\n  function timeAgo(d) {\n    const s=Math.floor((new Date()-new Date(d))/1000);\n    if(s<60) return 'Just now'; if(s<3600) return Math.floor(s/60)+'m ago';\n    if(s<86400) return Math.floor(s/3600)+'h ago'; return Math.floor(s/86400)+'d ago';\n  }\n\n  function notifIcon(type) {\n    const icons = {booking:'📅',task:'✅',message:'💬',group:'👥',system:'🔔',invite:'📩'};\n    return icons[type]||'🔔';\n  }\n\n  function notifItem(n) {\n    const title = n.title?.rendered||'Notification';\n    const body = n.meta?.message||n.content?.rendered?.replace(/<[^>]*>/g,'')||'';\n    const type = n.meta?.notification_type||'system';\n    const isRead = n.meta?.is_read==='1'||n.meta?.is_read===true;\n    const bg = isRead ? 'transparent' : '#f0fdfa';\n    const weight = isRead ? '400' : '600';\n    const link = n.meta?.link_url||'#';\n\n    return '<div style=\"padding:1rem; border-bottom:1px solid #f3f4f6; background:'+bg+'; display:flex; gap:0.75rem; align-items:start; cursor:pointer; transition:background 0.15s;\" onmouseover=\"this.style.background=\\'#f9fafb\\'\" onmouseout=\"this.style.background=\\''+bg+'\\'\" onclick=\"if(\\''+link+'\\'!==\\'#\\') window.location.href=\\''+link+'\\'\">'\n      +'<div style=\"font-size:1.5rem; flex-shrink:0;\">'+notifIcon(type)+'</div>'\n      +'<div style=\"flex:1; min-width:0;\">'\n      +'<div style=\"font-weight:'+weight+'; color:#111827; margin-bottom:0.2rem;\">'+title+'</div>'\n      +'<div style=\"font-size:0.85rem; color:#6b7280; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;\">'+body+'</div>'\n      +'<div style=\"font-size:0.7rem; color:#9ca3af; margin-top:0.25rem;\">'+timeAgo(n.date)+'</div>'\n      +'</div></div>';\n  }\n\n  function inviteItem(inv) {\n    const name = inv.title?.rendered||'Care Group Invitation';\n    const from = inv.meta?.inviter_name||'Someone';\n    return '<div style=\"padding:1rem; border-bottom:1px solid #f3f4f6; display:flex; justify-content:space-between; align-items:center;\">'\n      +'<div><div style=\"font-weight:600; color:#111827;\">'+name+'</div>'\n      +'<div style=\"font-size:0.85rem; color:#6b7280;\">From: '+from+' • '+timeAgo(inv.date)+'</div></div>'\n      +'<div style=\"display:flex; gap:0.5rem;\">'\n      +'<button onclick=\"window._acceptInvite('+inv.id+')\" style=\"padding:0.4rem 0.75rem; background:#22c55e; color:white; border:none; border-radius:6px; font-size:0.8rem; cursor:pointer;\">Accept</button>'\n      +'<button onclick=\"window._declineInvite('+inv.id+')\" style=\"padding:0.4rem 0.75rem; background:#ef4444; color:white; border:none; border-radius:6px; font-size:0.8rem; cursor:pointer;\">Decline</button>'\n      +'</div></div>';\n  }\n\n  function empty(msg,icon) { return '<div style=\"text-align:center; padding:3rem; color:#9ca3af;\"><div style=\"font-size:2rem; margin-bottom:0.5rem;\">'+icon+'</div><div>'+msg+'</div></div>'; }\n\n  async function loadNotifications() {\n    const userId = await getUser();\n    if (!userId) { document.getElementById('notif-list').innerHTML = empty('Please log in','🔒'); return; }\n    try {\n      const r = await fetch(baseUrl+'/chat_notification?author='+userId+'&per_page=30&orderby=date&order=desc',{credentials:'include'});\n      const notifs = r.ok ? await r.json() : [];\n      document.getElementById('notif-list').innerHTML = notifs.length===0 ? empty('No notifications yet','🔔') : notifs.map(notifItem).join('');\n    } catch(e) { document.getElementById('notif-list').innerHTML = empty('Failed to load','❌'); }\n  }\n\n  async function loadInvitations() {\n    const userId = await getUser();\n    if (!userId) { document.getElementById('invite-list').innerHTML = empty('Please log in','🔒'); return; }\n    try {\n      const r = await fetch(baseUrl+'/care_group_invite?meta_key=invitee_id&meta_value='+userId+'&per_page=20',{credentials:'include'});\n      const invites = r.ok ? await r.json() : [];\n      document.getElementById('invite-list').innerHTML = invites.length===0 ? empty('No pending invitations','📩') : invites.map(inviteItem).join('');\n    } catch(e) { document.getElementById('invite-list').innerHTML = empty('Failed to load','❌'); }\n  }\n\n  window._acceptInvite = async function(id) {\n    try {\n      const nonce = document.querySelector('meta[name=\"wp-nonce\"]')?.content||'';\n      await fetch(baseUrl+'/care_group_invite/'+id,{method:'POST',credentials:'include',headers:{'Content-Type':'application/json','X-WP-Nonce':nonce},body:JSON.stringify({meta:{status:'accepted'}})});\n      loadInvitations();\n    } catch(e) { alert('Failed to accept'); }\n  };\n  window._declineInvite = async function(id) {\n    try {\n      const nonce = document.querySelector('meta[name=\"wp-nonce\"]')?.content||'';\n      await fetch(baseUrl+'/care_group_invite/'+id,{method:'POST',credentials:'include',headers:{'Content-Type':'application/json','X-WP-Nonce':nonce},body:JSON.stringify({meta:{status:'declined'}})});\n      loadInvitations();\n    } catch(e) { alert('Failed to decline'); }\n  };\n\n  // Mark all read\n  document.getElementById('mark-all-read').addEventListener('click', async function() {\n    this.textContent = 'Marking...';\n    // In a real implementation, batch update all notifications\n    this.textContent = '✓ Done'; setTimeout(() => { this.textContent = 'Mark All Read'; }, 2000);\n    loadNotifications();\n  });\n\n  // Tab switching\n  document.querySelectorAll('.notif-tab').forEach(tab => {\n    tab.addEventListener('click', function() {\n      document.querySelectorAll('.notif-tab').forEach(t => { t.style.color='#6b7280'; t.style.borderBottomColor='transparent'; });\n      this.style.color='#0d9488'; this.style.borderBottomColor='#0d9488';\n      document.querySelectorAll('.notif-panel').forEach(p => p.style.display='none');\n      document.getElementById('notif-'+this.dataset.tab).style.display='block';\n    });\n  });\n\n  loadNotifications();\n  loadInvitations();\n})();\n</script>\n<!-- /wp:html -->\n\n\n</div>\n<!-- /wp:group --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->"}