{"content": "<!-- wp:columns {\"isStackedOnMobile\":false} -->\n<div class=\"wp-block-columns is-not-stacked-on-mobile\"><!-- wp:column {\"width\":\"220px\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:220px\"><!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"1rem\",\"right\":\"0.75rem\",\"bottom\":\"1rem\",\"left\":\"0.75rem\"}},\"border\":{\"right\":{\"color\":\"#e5e7eb\",\"width\":\"1px\"}}},\"backgroundColor\":\"base\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group has-base-background-color has-background\" style=\"border-right-color:#e5e7eb;border-right-width:1px;padding-top:1rem;padding-right:0.75rem;padding-bottom:1rem;padding-left:0.75rem\"><!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/dashboard/\">🏠 Dashboard</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/gps-tracking/\">📍 GPS Tracking</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column -->\n<!-- wp:column {\"style\":{\"color\":{\"background\":\"#f9fafb\"}}} -->\n<div class=\"wp-block-column has-background\" style=\"background-color:#f9fafb\">\n<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"right\":\"1.5rem\",\"left\":\"1.5rem\",\"bottom\":\"1.5rem\"}}}} -->\n<div class=\"wp-block-group\" style=\"padding-right:1.5rem;padding-left:1.5rem;padding-bottom:1.5rem\">\n<!-- wp:html -->\n<style>\n#gps70-shell{max-width:64rem;margin:0 auto;padding:1.5rem 1rem;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}\n#gps70-shell *{box-sizing:border-box}\n#gps70-shell .g70-header{margin-bottom:1.5rem}\n#gps70-shell .g70-header h1{font-size:1.5rem;font-weight:700;color:#0f172a;margin:0}\n#gps70-shell .g70-header p{margin:.25rem 0 0;font-size:.875rem;color:#64748b}\n#gps70-shell .g70-grid{display:grid;grid-template-columns:1fr 320px;gap:1rem}\n@media(max-width:768px){#gps70-shell .g70-grid{grid-template-columns:1fr}}\n#gps70-shell .g70-side{display:flex;flex-direction:column;gap:1rem}\n</style>\n<div id=\"gps70-shell\">\n  <div class=\"g70-header\">\n    <h1>GPS Tracking</h1>\n    <p>Monitor your care circle members' locations</p>\n  </div>\n  <div class=\"g70-grid\">\n    <div id=\"gps70-main-col\"></div>\n    <div class=\"g70-side\" id=\"gps70-side-col\"></div>\n  </div>\n</div>\n<script>\n(function(){\n  const base='/careconnected/wp-json/wp/v2';\n  const state={items:[],sharing:false,listeners:{}};\n  function emit(name){(state.listeners[name]||[]).forEach(fn=>{try{fn(state)}catch(e){}})}\n  function on(name,fn){state.listeners[name]=state.listeners[name]||[];state.listeners[name].push(fn);return()=>state.listeners[name]=(state.listeners[name]||[]).filter(x=>x!==fn)}\n  async function load(){\n    try{const r=await fetch(base+'/care_group?per_page=10',{credentials:'include'});state.items=r.ok?await r.json():[]}catch(e){state.items=[]}\n    emit('data')\n  }\n  function setSharing(v){state.sharing=!!v;emit('sharing')}\n  window.__gps70={state,on,emit,load,setSharing};\n  load();\n})();\n</script>\n<!-- /wp:html -->\n<!-- wp:html -->\n<style>\n#gps70-map{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}\n#gps70-map .g70-card{background:#fff;border-radius:.75rem;box-shadow:0 1px 3px rgba(0,0,0,.1);overflow:hidden;min-height:400px}\n#gps70-map .g70-map{width:100%;height:400px;background:#e2e8f0;display:flex;align-items:center;justify-content:center;color:#94a3b8;font-size:.875rem}\n</style>\n<div id=\"gps70-map\">\n  <div class=\"g70-card\"><div class=\"g70-map\" id=\"gps70-map-inner\">Map loading...</div></div>\n</div>\n<script>\n(function(){\n  function mount(){const main=document.getElementById('gps70-main-col'); if(main && !document.getElementById('gps70-map')) main.appendChild(document.currentScript.previousElementSibling.previousElementSibling)}\n  const root=document.getElementById('gps70-map');\n  const mapEl=document.getElementById('gps70-map-inner');\n  const main=document.getElementById('gps70-main-col'); if(main && root.parentElement!==main) main.appendChild(root);\n  function initMap(){\n    if(typeof L!=='undefined'){\n      mapEl.innerHTML='';\n      const map=L.map(mapEl).setView([40.7128,-74.006],12);\n      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'© OpenStreetMap'}).addTo(map);\n      L.marker([40.7128,-74.006]).addTo(map).bindPopup('Care Circle Member');\n      return;\n    }\n    const css=document.createElement('link'); css.rel='stylesheet'; css.href='https://unpkg.com/leaflet@1.9.4/dist/leaflet.css'; document.head.appendChild(css);\n    const js=document.createElement('script'); js.src='https://unpkg.com/leaflet@1.9.4/dist/leaflet.js'; js.onload=initMap; document.head.appendChild(js);\n  }\n  initMap();\n})();\n</script>\n<!-- /wp:html -->\n<!-- wp:html -->\n<style>\n#gps70-sharing{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}\n#gps70-sharing .g70-card{background:#fff;border-radius:.75rem;box-shadow:0 1px 3px rgba(0,0,0,.1);border:1px solid transparent}\n#gps70-sharing .g70-body{padding:1rem 1.25rem}\n#gps70-sharing .g70-row{display:flex;align-items:center;justify-content:space-between;gap:1rem}\n#gps70-sharing .g70-label{font-size:.875rem;color:#334155}\n#gps70-sharing .g70-desc{font-size:.75rem;color:#94a3b8;margin-top:.125rem}\n#gps70-sharing .g70-switch{width:44px;height:24px;border-radius:12px;background:#e2e8f0;position:relative;cursor:pointer;border:none;transition:background .2s;flex-shrink:0}\n#gps70-sharing .g70-switch.on{background:#0d9488}\n#gps70-sharing .g70-switch::after{content:'';position:absolute;top:2px;left:2px;width:20px;height:20px;border-radius:50%;background:#fff;transition:transform .2s;box-shadow:0 1px 2px rgba(0,0,0,.1)}\n#gps70-sharing .g70-switch.on::after{transform:translateX(20px)}\n</style>\n<div id=\"gps70-sharing\"><div class=\"g70-card\"><div class=\"g70-body\"><div class=\"g70-row\"><div><div class=\"g70-label\">Share My Location</div><div class=\"g70-desc\">Allow care circle members to see your location</div></div><button class=\"g70-switch\" id=\"gps70-share-switch\" type=\"button\"></button></div></div></div></div>\n<script>\n(function(){\n  const root=document.getElementById('gps70-sharing'); const side=document.getElementById('gps70-side-col'); if(side && root.parentElement!==side) side.appendChild(root);\n  const sw=document.getElementById('gps70-share-switch');\n  sw.addEventListener('click',()=>{sw.classList.toggle('on'); if(window.__gps70) window.__gps70.setSharing(sw.classList.contains('on'))});\n})();\n</script>\n<!-- /wp:html -->\n<!-- wp:html -->\n<style>\n#gps70-members{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}\n#gps70-members .g70-card{background:#fff;border-radius:.75rem;box-shadow:0 1px 3px rgba(0,0,0,.1);border:1px solid transparent}\n#gps70-members .g70-hdr{padding:1rem 1.25rem 0;font-weight:600;font-size:.9375rem;color:#0f172a}\n#gps70-members .g70-body{padding:1rem 1.25rem}\n#gps70-members .g70-member{display:flex;align-items:center;gap:.75rem;padding:.75rem 0;border-bottom:1px solid #f1f5f9}\n#gps70-members .g70-member:last-child{border-bottom:none}\n#gps70-members .g70-avatar{width:36px;height:36px;border-radius:50%;background:rgba(13,148,136,.1);display:flex;align-items:center;justify-content:center;color:#0d9488;font-weight:500;font-size:.8125rem;flex-shrink:0}\n#gps70-members .g70-info{flex:1;min-width:0}\n#gps70-members .g70-name{font-size:.875rem;font-weight:500;color:#0f172a}\n#gps70-members .g70-loc{font-size:.7rem;color:#94a3b8}\n#gps70-members .g70-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}\n#gps70-members .g70-online{background:#22c55e}\n#gps70-members .g70-offline{background:#94a3b8}\n#gps70-members .g70-empty{text-align:center;padding:1rem;color:#94a3b8;font-size:.8125rem}\n</style>\n<div id=\"gps70-members\"><div class=\"g70-card\"><div class=\"g70-hdr\">Care Circle Members</div><div class=\"g70-body\"><div class=\"g70-empty\">Loading members...</div></div></div></div>\n<script>\n(function(){\n  const root=document.getElementById('gps70-members'); const side=document.getElementById('gps70-side-col'); if(side && root.parentElement!==side) side.appendChild(root);\n  function render(){\n    const api=window.__gps70;if(!api)return; const body=root.querySelector('.g70-body'); const items=api.state.items||[];\n    if(!items.length){body.innerHTML='<div class=\"g70-empty\">No care circle members found</div>';return}\n    body.innerHTML=items.slice(0,5).map((g,i)=>{const name=g.title?.rendered||('Member '+(i+1)); const init=name.charAt(0).toUpperCase(); const online=i%2===0; return '<div class=\"g70-member\"><div class=\"g70-avatar\">'+init+'</div><div class=\"g70-info\"><div class=\"g70-name\">'+name+'</div><div class=\"g70-loc\">'+(online?'Last seen just now':'Last seen 2h ago')+'</div></div><div class=\"g70-dot '+(online?'g70-online':'g70-offline')+'\"></div></div>'}).join('');\n  }\n  function bind(){const api=window.__gps70;if(!api)return false;api.on('data',render);render();return true}\n  if(!bind()){const t=setInterval(()=>{if(bind())clearInterval(t)},200)}\n})();\n</script>\n<!-- /wp:html -->\n<!-- wp:html -->\n<style>\n#gps70-alerts{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}\n#gps70-alerts .g70-card{background:#fff;border-radius:.75rem;box-shadow:0 1px 3px rgba(0,0,0,.1);border:1px solid transparent}\n#gps70-alerts .g70-hdr{padding:1rem 1.25rem 0;font-weight:600;font-size:.9375rem;color:#0f172a}\n#gps70-alerts .g70-body{padding:1rem 1.25rem}\n#gps70-alerts .g70-empty{text-align:center;padding:.5rem;color:#94a3b8;font-size:.8125rem}\n#gps70-alerts .g70-sos{display:flex;align-items:center;justify-content:center;gap:.5rem;width:100%;padding:.75rem;background:#ef4444;color:#fff;border:none;border-radius:.75rem;font-size:1rem;font-weight:600;cursor:pointer;transition:opacity .15s}\n#gps70-alerts .g70-sos:hover{opacity:.9}\n</style>\n<div id=\"gps70-alerts\"><div class=\"g70-card\"><div class=\"g70-hdr\">Geofence Alerts</div><div class=\"g70-body\"><div class=\"g70-empty\">No active alerts</div></div></div><div style=\"margin-top:1rem\"><button class=\"g70-sos\" type=\"button\" id=\"gps70-sos-btn\">Emergency SOS</button></div></div>\n<script>\n(function(){\n  const root=document.getElementById('gps70-alerts'); const side=document.getElementById('gps70-side-col'); if(side && root.parentElement!==side) side.appendChild(root);\n  document.getElementById('gps70-sos-btn').addEventListener('click',()=>{if(confirm('Send an emergency SOS notification to your care circle members?')) alert('SOS notification sent!')});\n})();\n</script>\n<!-- /wp:html -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->", "status": "publish"}