{"content": "<!-- wp:columns {\"isStackedOnMobile\":false} -->\n<div class=\"wp-block-columns is-not-stacked-on-mobile\"><!-- wp:column {\"width\":\"220px\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:220px\"><!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"1rem\",\"right\":\"0.75rem\",\"bottom\":\"1rem\",\"left\":\"0.75rem\"}},\"border\":{\"right\":{\"color\":\"#e5e7eb\",\"width\":\"1px\"}}},\"backgroundColor\":\"base\",\"layout\":{\"type\":\"flex\",\"orientation\":\"vertical\"}} -->\n<div class=\"wp-block-group has-base-background-color has-background\" style=\"border-right-color:#e5e7eb;border-right-width:1px;padding-top:1rem;padding-right:0.75rem;padding-bottom:1rem;padding-left:0.75rem\"><!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/dashboard/\">🏠 Dashboard</a></p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"style\":{\"spacing\":{\"padding\":{\"top\":\"0.5rem\",\"right\":\"0.75rem\",\"bottom\":\"0.5rem\",\"left\":\"0.75rem\"}},\"typography\":{\"fontSize\":\"0.875rem\"}}} -->\n<p style=\"padding-top:0.5rem;padding-right:0.75rem;padding-bottom:0.5rem;padding-left:0.75rem;font-size:0.875rem\"><a href=\"/careconnected/articles/\">📰 Articles</a></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:column -->\n<!-- wp:column {\"style\":{\"color\":{\"background\":\"#f9fafb\"}}} -->\n<div class=\"wp-block-column has-background\" style=\"background-color:#f9fafb\">\n<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"right\":\"1.5rem\",\"left\":\"1.5rem\",\"bottom\":\"1.5rem\"}}}} -->\n<div class=\"wp-block-group\" style=\"padding-right:1.5rem;padding-left:1.5rem;padding-bottom:1.5rem\">\n<!-- wp:html -->\n<style>\n#articles70-shell{max-width:48rem;margin:0 auto;padding:1.5rem 1rem;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}\n#articles70-shell *{box-sizing:border-box}\n#articles70-shell .a70-header{display:flex;align-items:center;justify-content:space-between;gap:.75rem;flex-wrap:wrap;margin-bottom:1.5rem}\n#articles70-shell .a70-header h1{font-size:1.5rem;font-weight:700;color:#0f172a;margin:0}\n#articles70-shell .a70-header p{margin:.25rem 0 0;font-size:.875rem;color:#64748b}\n#articles70-shell .a70-btn{display:inline-flex;align-items:center;gap:.5rem;padding:.5rem 1rem;border:none;border-radius:.5rem;font-size:.875rem;font-weight:500;cursor:pointer;background:#0d9488;color:#fff}\n#articles70-shell .a70-filters{display:flex;gap:.5rem;margin-bottom:1.5rem;flex-wrap:wrap}\n#articles70-shell .a70-filter{padding:.375rem .75rem;border-radius:9999px;font-size:.8125rem;font-weight:500;cursor:pointer;border:1px solid #e2e8f0;background:#fff;color:#64748b}\n#articles70-shell .a70-filter.active{background:#0d9488;color:#fff;border-color:#0d9488}\n</style>\n<div id=\"articles70-shell\">\n  <div class=\"a70-header\">\n    <div><h1>Articles</h1><p>Read and share care knowledge</p></div>\n    <button class=\"a70-btn\" type=\"button\" id=\"articles70-new-btn\">Write Article</button>\n  </div>\n  <div class=\"a70-filters\">\n    <button class=\"a70-filter active\" data-filter=\"all\" type=\"button\">All</button>\n    <button class=\"a70-filter\" data-filter=\"mine\" type=\"button\">My Articles</button>\n    <button class=\"a70-filter\" data-filter=\"user\" type=\"button\">User</button>\n    <button class=\"a70-filter\" data-filter=\"expert\" type=\"button\">Expert</button>\n    <button class=\"a70-filter\" data-filter=\"official\" type=\"button\">Official</button>\n  </div>\n</div>\n<script>\n(function(){\n  const base='/careconnected/wp-json/wp/v2';\n  const state={uid:null,filter:'all',items:[],listeners:{}};\n  function emit(name){(state.listeners[name]||[]).forEach(fn=>{try{fn(state)}catch(e){}})}\n  function on(name,fn){state.listeners[name]=state.listeners[name]||[];state.listeners[name].push(fn);return()=>state.listeners[name]=(state.listeners[name]||[]).filter(x=>x!==fn)}\n  async function getUid(){if(state.uid)return state.uid;try{const r=await fetch(base+'/users/me',{credentials:'include'});if(!r.ok)return null;state.uid=(await r.json()).id;return state.uid}catch(e){return null}}\n  function setFilter(v){state.filter=v;document.querySelectorAll('#articles70-shell .a70-filter').forEach(btn=>btn.classList.toggle('active',btn.dataset.filter===v));emit('filter')}\n  function nonce(){return document.querySelector('meta[name=\"wp-nonce\"]')?.content||''}\n  async function load(){await getUid();try{const r=await fetch(base+'/care_article?per_page=50&orderby=date&order=desc&_embed',{credentials:'include'});state.items=r.ok?await r.json():[]}catch(e){state.items=[]}emit('data')}\n  async function save(id,payload){const url=id?base+'/care_article/'+id:base+'/care_article';await fetch(url,{method:'POST',credentials:'include',headers:{'Content-Type':'application/json','X-WP-Nonce':nonce()},body:JSON.stringify(payload)});await load()}\n  async function remove(id){await fetch(base+'/care_article/'+id+'?force=true',{method:'DELETE',credentials:'include',headers:{'X-WP-Nonce':nonce()}});await load()}\n  window.__articles70={state,on,emit,setFilter,load,save,remove,openModal(detail){window.dispatchEvent(new CustomEvent('articles70:modal-open',{detail}))}};\n  document.querySelectorAll('#articles70-shell .a70-filter').forEach(btn=>btn.addEventListener('click',()=>setFilter(btn.dataset.filter)));\n  document.getElementById('articles70-new-btn').addEventListener('click',()=>window.__articles70.openModal(null));\n  setFilter('all');\n  load();\n})();\n</script>\n<!-- /wp:html -->\n<!-- wp:html -->\n<style>\n#articles70-feed{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}\n#articles70-feed .a70-card{background:#fff;border-radius:.75rem;box-shadow:0 1px 3px rgba(0,0,0,.1);border:1px solid transparent;padding:1.25rem;margin-bottom:1rem}\n#articles70-feed .a70-top{display:flex;align-items:center;justify-content:space-between;gap:.75rem;margin-bottom:.75rem}\n#articles70-feed .a70-author{display:flex;align-items:center;gap:.75rem}\n#articles70-feed .a70-avatar{width:40px;height:40px;border-radius:50%;background:rgba(13,148,136,.1);display:flex;align-items:center;justify-content:center;color:#0d9488;font-weight:500;font-size:.875rem;flex-shrink:0}\n#articles70-feed .a70-name{font-weight:500;font-size:.9375rem;color:#0f172a}\n#articles70-feed .a70-time{font-size:.7rem;color:#94a3b8}\n#articles70-feed .a70-badge{display:inline-block;padding:.125rem .5rem;border-radius:9999px;font-size:.65rem;font-weight:500;margin-left:.5rem}\n#articles70-feed .a70-user{background:#dbeafe;color:#1e40af}\n#articles70-feed .a70-expert{background:#fef3c7;color:#92400e}\n#articles70-feed .a70-official{background:#dcfce7;color:#166534}\n#articles70-feed .a70-title{font-size:1rem;font-weight:600;color:#0f172a;margin:0 0 .5rem}\n#articles70-feed .a70-body{font-size:.875rem;color:#475569;line-height:1.5;margin-bottom:.75rem;display:-webkit-box;display:box;line-clamp:4;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}\n#articles70-feed .a70-footer{display:flex;align-items:center;justify-content:space-between;padding-top:.75rem;border-top:1px solid #f1f5f9}\n#articles70-feed .a70-vote{display:flex;align-items:center;gap:.25rem}\n#articles70-feed .a70-vote-btn{width:28px;height:28px;display:flex;align-items:center;justify-content:center;border:none;background:transparent;cursor:pointer;border-radius:.25rem;color:#94a3b8;font-size:1rem}\n#articles70-feed .a70-vote-btn:hover{background:#f1f5f9;color:#0d9488}\n#articles70-feed .a70-count{font-size:.875rem;font-weight:600;color:#0f172a;min-width:24px;text-align:center}\n#articles70-feed .a70-menu button{background:none;border:none;color:#64748b;font-size:.8125rem;cursor:pointer;padding:.25rem .5rem}\n#articles70-feed .a70-empty{text-align:center;padding:3rem 1rem;color:#94a3b8;font-size:.875rem}\n</style>\n<div id=\"articles70-feed\">\n  <div class=\"a70-empty\">Loading articles...</div>\n</div>\n<script>\n(function(){\n  const root=document.getElementById('articles70-feed');\n  const badgeClass={user:'a70-user',expert:'a70-expert',official:'a70-official'};\n  function timeAgo(d){const s=Math.floor((Date.now()-new Date(d).getTime())/1000);if(s<60)return'Just now';if(s<3600)return Math.floor(s/60)+'m ago';if(s<86400)return Math.floor(s/3600)+'h ago';return Math.floor(s/86400)+'d ago'}\n  function strip(v){return (v||'').replace(/<[^>]*>/g,'')}\n  function render(){\n    const api=window.__articles70;if(!api)return; let items=api.state.items||[];\n    if(api.state.filter==='mine'&&api.state.uid) items=items.filter(a=>a.author===api.state.uid);\n    else if(api.state.filter!=='all'&&api.state.filter!=='mine') items=items.filter(a=>(a.meta?.article_type||'user')===api.state.filter);\n    if(!items.length){root.innerHTML='<div class=\"a70-empty\">No articles found</div>';return}\n    root.innerHTML=items.map(a=>{const author=a._embedded?.author?.[0]?.name||'User'; const owned=a.author===api.state.uid; const type=a.meta?.article_type||'user'; const menu=owned?'<div class=\"a70-menu\"><button type=\"button\" onclick=\"window.__articles70.openModal({id:'+a.id+',title:'+JSON.stringify(a.title?.rendered||'')+',content:'+JSON.stringify(strip(a.content?.rendered||''))+',type:'+JSON.stringify(type)+'})\">Edit</button><button type=\"button\" onclick=\"window.__articles70.remove('+a.id+')\">Delete</button></div>':''; return '<div class=\"a70-card\"><div class=\"a70-top\"><div class=\"a70-author\"><div class=\"a70-avatar\">'+author.charAt(0).toUpperCase()+'</div><div><div class=\"a70-name\">'+author+'<span class=\"a70-badge '+(badgeClass[type]||'a70-user')+'\">'+type+'</span></div><div class=\"a70-time\">'+timeAgo(a.date)+'</div></div></div>'+menu+'</div>'+(a.title?.rendered?'<h3 class=\"a70-title\">'+a.title.rendered+'</h3>':'')+'<div class=\"a70-body\">'+strip(a.content?.rendered||'')+'</div><div class=\"a70-footer\"><div class=\"a70-vote\"><button class=\"a70-vote-btn\" type=\"button\" onclick=\"window.__articles70.save('+a.id+',{meta:{vote_count:' + ((a.meta?.vote_count||0)+1) + '}})\">▲</button><span class=\"a70-count\">'+(a.meta?.vote_count||0)+'</span><button class=\"a70-vote-btn\" type=\"button\" onclick=\"window.__articles70.save('+a.id+',{meta:{vote_count:' + ((a.meta?.vote_count||0)-1) + '}})\">▼</button></div></div></div>';}).join('');\n  }\n  function bind(){const api=window.__articles70;if(!api)return false;api.on('data',render);api.on('filter',render);render();return true}\n  if(!bind()){const t=setInterval(()=>{if(bind())clearInterval(t)},200)}\n})();\n</script>\n<!-- /wp:html -->\n<!-- wp:html -->\n<style>\n#articles70-modal{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}\n#articles70-modal .a70-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:100;align-items:center;justify-content:center}\n#articles70-modal .a70-overlay.show{display:flex}\n#articles70-modal .a70-modal{background:#fff;border-radius:.75rem;padding:1.5rem;max-width:32rem;width:90%;max-height:90vh;overflow-y:auto;box-shadow:0 25px 50px -12px rgba(0,0,0,.25)}\n#articles70-modal .a70-modal h3{font-size:1.125rem;font-weight:600;margin:0 0 1rem;color:#0f172a}\n#articles70-modal .a70-label{display:block;margin:.75rem 0 .25rem;font-size:.8125rem;font-weight:500;color:#334155}\n#articles70-modal .a70-input,#articles70-modal .a70-textarea,#articles70-modal .a70-select{width:100%;padding:.5rem;border:1px solid #e2e8f0;border-radius:.375rem;font-size:.875rem;font-family:inherit}\n#articles70-modal .a70-textarea{resize:vertical}\n#articles70-modal .a70-actions{display:flex;gap:.5rem;justify-content:flex-end;margin-top:1.25rem}\n#articles70-modal .a70-btn{display:inline-flex;align-items:center;gap:.5rem;padding:.5rem 1rem;border:none;border-radius:.5rem;font-size:.875rem;font-weight:500;cursor:pointer}\n#articles70-modal .a70-primary{background:#0d9488;color:#fff}\n#articles70-modal .a70-outline{background:#fff;color:#334155;border:1px solid #e2e8f0}\n</style>\n<div id=\"articles70-modal\">\n  <div class=\"a70-overlay\" id=\"articles70-overlay\">\n    <div class=\"a70-modal\">\n      <h3 id=\"articles70-modal-title\">Write Article</h3>\n      <label class=\"a70-label\" for=\"articles70-title\">Title *</label>\n      <input class=\"a70-input\" id=\"articles70-title\" type=\"text\" placeholder=\"Article title\">\n      <label class=\"a70-label\" for=\"articles70-content\">Content *</label>\n      <textarea class=\"a70-textarea\" id=\"articles70-content\" rows=\"8\" placeholder=\"Write your article content...\"></textarea>\n      <label class=\"a70-label\" for=\"articles70-type\">Type</label>\n      <select class=\"a70-select\" id=\"articles70-type\"><option value=\"user\">User</option><option value=\"expert\">Expert</option><option value=\"official\">Official</option></select>\n      <div class=\"a70-actions\">\n        <button class=\"a70-btn a70-outline\" type=\"button\" id=\"articles70-cancel\">Cancel</button>\n        <button class=\"a70-btn a70-primary\" type=\"button\" id=\"articles70-submit\">Publish</button>\n      </div>\n    </div>\n  </div>\n</div>\n<script>\n(function(){\n  let editingId=null;\n  const overlay=document.getElementById('articles70-overlay');\n  function open(detail){editingId=detail?.id||null;document.getElementById('articles70-modal-title').textContent=editingId?'Edit Article':'Write Article';document.getElementById('articles70-title').value=detail?.title||'';document.getElementById('articles70-content').value=detail?.content||'';document.getElementById('articles70-type').value=detail?.type||'user';document.getElementById('articles70-submit').textContent=editingId?'Update':'Publish';overlay.classList.add('show')}\n  function close(){overlay.classList.remove('show')}\n  function bind(){const api=window.__articles70;if(!api)return false;window.addEventListener('articles70:modal-open',e=>open(e.detail||null));document.getElementById('articles70-cancel').addEventListener('click',close);overlay.addEventListener('click',e=>{if(e.target===overlay)close()});document.getElementById('articles70-submit').addEventListener('click',async()=>{const btn=document.getElementById('articles70-submit');const title=document.getElementById('articles70-title').value.trim();const content=document.getElementById('articles70-content').value.trim();const type=document.getElementById('articles70-type').value;if(!title||!content)return;btn.textContent='Saving...';try{await api.save(editingId,{title,content,status:'publish',meta:{article_type:type}});close()}catch(e){alert('Failed to save article')}finally{btn.textContent=editingId?'Update':'Publish'}});return true}\n  if(!bind()){const t=setInterval(()=>{if(bind())clearInterval(t)},200)}\n})();\n</script>\n<!-- /wp:html -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->", "status": "publish"}