    "location": [
      [
        {
          "param": "post_type",
          "operator": "==",
          "value": "care_group"
        }
      ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "active": true
  },
  {
    "key": "group_care_task_details",
