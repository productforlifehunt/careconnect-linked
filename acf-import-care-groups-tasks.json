        "instructions": "Type of care group",
        "required": 1,
        "choices": {
          "family": "Family",
          "professional": "Professional",
          "community": "Community",
          "mixed": "Mixed"
        },
        "default_value": "family",
        "return_format": "value"
      },
      {
        "key": "field_cg_cover_image",
        "label": "Cover Image",
        "name": "cover_image",
        "type": "image",
