      {
        "key": "field_cg_members",
        "label": "Members",
        "name": "members",
        "type": "user",
        "instructions": "Users who are members of this care group",
        "required": 0,
        "role": "",
        "multiple": 1,
        "return_format": "id"
      },
      {
        "key": "field_cg_privacy",
        "label": "Privacy",
        "name": "privacy",
        "type": "select",
        "instructions": "Privacy setting for the group",
