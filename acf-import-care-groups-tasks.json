        "required": 0,
        "return_format": "url",
        "preview_size": "medium"
      },
      {
        "key": "field_cg_is_active",
        "label": "Is Active",
        "name": "is_active",
        "type": "true_false",
        "instructions": "Whether the care group is currently active",
        "required": 0,
        "default_value": 1,
        "ui": 1
      },
      {
        "key": "field_cg_max_members",
        "label": "Max Members",
        "name": "max_members",
        "type": "number",
